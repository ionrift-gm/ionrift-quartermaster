<form class="ionrift-progression-registry">

    {{!-- ══ TAB BAR ══════════════════════════════════════════════ --}}
    <div class="registry-tabs">
        <div class="registry-tabs-primary">
            <button type="button" class="registry-tab {{#if (eq activeTab 'signatures')}}active{{/if}}" data-tab="signatures">
                <i class="fas fa-book-sparkles"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.Signatures'}}
            </button>
            <button type="button" class="registry-tab {{#if (eq activeTab 'scrolls')}}active{{/if}}" data-tab="scrolls">
                <i class="fas fa-scroll"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.ScrollPlan'}}
            </button>
            <button type="button" class="registry-tab {{#if (eq activeTab 'party')}}active{{/if}}" data-tab="party">
                <i class="fas fa-users"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyShelf'}}
            </button>
            <button type="button" class="registry-tab {{#if (eq activeTab 'cursed')}}active{{/if}}" data-tab="cursed">
                <i class="fas fa-skull"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.CursedPool'}}
            </button>
        </div>
        <button type="button" class="registry-tab {{#if (eq activeTab 'banlist')}}active{{/if}}" data-tab="banlist">
            <i class="fas fa-ban"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.BanList'}}
            {{#if banCount}}<span class="tab-badge">{{banCount}}</span>{{/if}}
        </button>
    </div>

    {{!-- ══ SIGNATURES ══════════════════════════════════════════ --}}
    {{#if (eq activeTab 'signatures')}}
    <div class="registry-panel panel-signatures">
        <p class="tab-desc"><i class="fas fa-book-sparkles"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesDesc1'}}<span class="desc-highlight">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesDesc2'}}</span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesDesc3'}}<span class="desc-highlight">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesDesc4'}}</span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesDesc5'}}</p>
        <p class="tab-desc tab-desc-philosophy"><strong>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesPhilosophyTitle'}}</strong>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignaturesPhilosophy'}}</p>
        <div class="ledger-scroll-area">

            <div class="ledger-grid-header sig-header">
                <div class="grid-corner grid-corner-sig">
                    <span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Character'}}</span>
                    <button type="button" class="btn-manage-party" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ChooseCharacters'}}">
                        <i class="fas fa-user-gear"></i>
                    </button>
                </div>
                {{#each milestones}}<div class="grid-col-header">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this}}</div>{{/each}}
            </div>

            {{#each actors}}
            <div class="ledger-grid-row sig-row {{#if this.isBehind}}row-behind{{/if}}">

                <div class="grid-actor-cell">
                    <img src="{{this.img}}" class="actor-img" alt="{{this.name}}" />
                    <div class="actor-info">
                        <span class="actor-name" title="{{this.name}}">{{this.name}}</span>
                        <div class="actor-sub-row">
                            <span class="actor-sub">{{this.classes}} ({{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this.level}})</span>
                            <div class="actor-toolbar">
                                <span class="sig-budget-pips" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SignatureBudget'}}">
                                    {{#each this.budgetPips}}<span class="budget-pip {{#if this.filled}}pip-filled{{else}}pip-empty{{/if}}"></span>{{/each}}
                                    <span class="budget-count">{{this.budgetUsed}}/{{this.budgetTotal}}</span>
                                </span>
                                {{#if this.hasEmptySlots}}
                                <button type="button" class="btn-seed-inline action-seed-signatures"
                                        data-actor-id="{{this.id}}"
                                        title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.FillEmptySlots'}}"
                                        aria-label="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.FillEmptySlots'}}">
                                    <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                                </button>
                                {{/if}}
                            </div>
                        </div>
                        {{#if this.showStat}}
                        <div class="sig-actor-stat {{this.powerTier}}" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RawPowerScore' score=this.powerScore avg=../avgPower}}">
                            <div class="power-bar-track sig-actor-stat-bar power-bar-centered" data-sign="{{this.powerSign}}">
                                <span class="power-bar-centerline" aria-hidden="true"></span>
                                <div class="power-bar-fill" style="width:{{this.powerBarHalfPct}}%;"></div>
                            </div>
                            <span class="stat-deviation sig-actor-stat-label">{{this.powerLabel}}</span>
                        </div>
                        {{/if}}
                    </div>
                </div>

                <div class="sig-slots-strip">
                    <div class="sig-row-level-range" aria-hidden="true">
                        <div class="sig-row-level-range-fill" style="width: {{this.levelRangeBarPct}}%;"></div>
                    </div>
                {{#each this.slots}}
                {{> "modules/ionrift-quartermaster/templates/partials/slot-cell.hbs" this variant=""}}
                {{/each}}
                </div>

            </div>

            {{#if this.isBehind}}
            <div class="row-warning-banner">
                <i class="fas fa-exclamation-triangle"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.UnderEquippedWarning' name=this.name label=this.powerLabel}}
            </div>
            {{/if}}

            {{else}}
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <p>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.NoPlayerCharacters'}}</p>
            </div>
            {{/each}}
        </div>
        <div class="ledger-footer ledger-footer-sig">
            <span class="footer-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.AvgPower' avg=avgPower}}</span>
            <span class="footer-hint footer-hint-philosophy"><em>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.VariationHint'}}</em></span>
        </div>
    </div>
    {{/if}}

    {{!-- ══ SCROLL PLAN ══════════════════════════════════════════ --}}
    {{#if (eq activeTab 'scrolls')}}
    <div class="registry-panel panel-scrolls">
        <div class="ledger-scroll-area cursed-scroll-area">

            {{#with scrollPinnedRow}}
            {{!-- ── Scroll Policy Dashboard (always visible) ─────────── --}}
            <div class="qm-policy-dashboard scroll-policy-dashboard">
                <div class="policy-hero-badge">
                    <span class="policy-hero-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyLevel'}}</span>
                    <span class="policy-hero-value">{{../scrollPolicyData.partyLevel}}</span>
                </div>

                <div class="policy-bar-chart">
                    {{#each ../scrollPolicyData.distribution}}
                    <div class="policy-bar-col {{#if this.isOptimal}}policy-bar-optimal{{/if}}">
                        <div class="policy-bar" style="height: {{this.barHeight}}%;"></div>
                        <span class="policy-bar-pct">{{this.percent}}%</span>
                        <span class="policy-bar-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this.level}}</span>
                    </div>
                    {{/each}}
                </div>

                <div class="policy-sliders-row">
                    <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.FloorTooltip'}}">
                        <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Floor'}} <span class="policy-slider-value">{{../scrollFloor}}</span></label>
                        <input type="range" class="policy-slider action-update-scroll-floor" min="1" max="9" step="1" value="{{../scrollFloor}}">
                    </div>
                    <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ConcentrationTooltip'}}">
                        <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Concentration'}} <span class="policy-slider-value">{{../scrollConcentration}}</span></label>
                        <input type="range" class="policy-slider action-update-scroll-concentration" min="1" max="5" step="1" value="{{../scrollConcentration}}">
                    </div>
                    <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OptimalOffsetTooltip'}}">
                        <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OptimalOffset'}} <span class="policy-slider-value">{{../scrollPolicyData.offsetLabel}}</span></label>
                        <input type="range" class="policy-slider action-update-scroll-offset" min="-4" max="4" step="1" value="{{../scrollOffset}}">
                    </div>
                    <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.UpperReachTooltip'}}">
                        <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.UpperReach'}} <span class="policy-slider-value">+{{../scrollUpperReach}}</span></label>
                        <input type="range" class="policy-slider action-update-scroll-upper-reach" min="0" max="4" step="1" value="{{../scrollUpperReach}}">
                    </div>
                </div>

                <div class="dashboard-footer-actions">
                    <div style="display: flex; justify-content: flex-end; margin-bottom: 4px;">
                        <a role="button" class="btn-qm-reset action-reset-scroll-defaults" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ResetScrollDefaults'}}">
                            <i class="fas fa-undo"></i>
                        </a>
                    </div>
                    <button type="button" class="btn-qm-override action-toggle-scroll-tracker {{#if ../scrollTrackerExpanded}}is-expanded{{/if}}">
                        <i class="fas {{#if ../scrollTrackerExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
                        {{#if ../scrollTrackerExpanded}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CollapseScrollOverrides'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OverrideOnSpecificScrolls'}}{{/if}}
                    </button>
                </div>
            </div>

            {{!-- ── Accordion: tracker grid expands below dashboard ─── --}}
            <div class="qm-tracker-accordion {{#if ../scrollTrackerExpanded}}qm-tracker-accordion-open{{/if}}">
                
                <div class="qm-tracker-accordion-scrollable">
                    {{!-- ── Pinned Scrolls Section ─────────────────────────── --}}
                    <div class="scroll-section-header scroll-pinned-header">
                        <div class="scroll-section-header-row">
                            <span class="scroll-section-title"><i class="fas fa-thumbtack"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.PinnedScrolls'}}</span>
                        </div>
                    </div>
        
                    {{#unless ../hasParty}}
                    <div class="no-party-notice">
                        <i class="fas fa-users-slash"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.NoPartyReachBand'}}
                    </div>
                    {{/unless}}

                    <span class="scroll-section-hint qm-accordion-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ScrollBoardHint1'}}<strong class="hint-highlight">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ScrollBoardHint2'}}</strong>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ScrollBoardHint3'}}</span>
                    
                    <div class="cursed-planned-strip-wrap scroll-planned-strip-wrap">
                    <div class="cursed-planned-col-labels scroll-planned-col-labels">
                        <div class="cursed-planned-col-labels-grid">
                            {{#each milestoneLabels}}
                            <div class="cursed-planned-col-label scroll-planned-col-label" style="opacity: {{this.labelFade}};">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this.level}}</div>
                            {{/each}}
                        </div>
                        <div class="cursed-planned-median-overlay">
                            <div class="cursed-planned-median-track" style="width: {{levelRangeBarPct}}%;">
                                <span class="cursed-band-level-tip scroll-band-level-tip">{{partyLevelLabel}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="cursed-planned-band-row scroll-planned-band-row">
                        <div class="sig-row-level-range cursed-row-level-range scroll-row-level-range" aria-hidden="true">
                            <div class="sig-row-level-range-fill cursed-level-range-fill scroll-level-range-fill" style="width: {{levelRangeBarPct}}%;"></div>
                        </div>
                    </div>

                    <div class="sig-slots-strip cursed-slots-strip scroll-slots-strip">
                        {{#each columns}}
                        <div class="cursed-milestone-stack scroll-milestone-stack">
                            {{#each this.slots}}
                            <div class="grid-slot scroll-slot {{#if this.filled}}slot-filled rarity-{{this.rarity}}{{else}}slot-empty{{/if}} {{#if this.delivered}}slot-delivered{{/if}} {{#if this.isPast}}slot-past{{/if}} {{#if this.isFuture}}slot-future{{/if}} {{#if this.isCurrent}}slot-current{{/if}} {{#if this.isNext}}slot-next{{/if}} {{#if this.isOverdue}}slot-overdue{{/if}} {{#if this.reachGlowActive}}slot-reach-glow{{/if}} {{#if this.locked}}slot-locked{{/if}}"
                                 data-level="{{this.level}}"
                                 data-slot-idx="{{this.slotIdx}}"
                                 {{#if this.uuid}}data-uuid="{{this.uuid}}"{{/if}}
                                 {{#if this.name}}data-name="{{this.name}}"{{/if}}
                                 draggable="{{#if this.filled}}true{{else}}false{{/if}}"
                                 style="--ir-reach-blend: {{this.reachBlend}}; --ir-reach-glow: {{this.reachGlow}};">
                                {{#if this.filled}}
                                    <img src="{{this.img}}" class="slot-item-img" alt="{{this.name}}" draggable="false" />
                                    {{!-- Spell level badge --}}
                                    {{#if this.spellLevel}}<span class="scroll-slot-level-badge">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this.spellLevel}}</span>{{/if}}
                                    {{!-- Lock --}}
                                    <button type="button" class="slot-btn slot-btn-lock action-toggle-lock {{#if this.locked}}is-locked{{/if}}"
                                            data-level="{{this.level}}" data-uuid="{{this.uuid}}" data-variant="scroll"
                                            title="{{#if this.locked}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Unlock'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Lock'}}{{/if}}">
                                        <i class="fas {{#if this.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                    </button>
                                    {{!-- Remove --}}
                                    <button type="button" class="slot-btn slot-btn-remove action-remove-scroll-pin"
                                            data-level="{{this.level}}" data-uuid="{{this.uuid}}" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RemovePinnedScroll'}}">
                                        <i class="fas fa-times"></i>
                                    </button>
                                    {{!-- Delivered toggle --}}
                                    <button type="button" class="slot-btn slot-btn-bl action-toggle-scroll-delivered"
                                            data-level="{{this.level}}" data-uuid="{{this.uuid}}"
                                            title="{{#if this.delivered}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.MarkUndelivered'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.MarkDelivered'}}{{/if}}">
                                        <i class="fas {{#if this.delivered}}fa-rotate-left{{else}}fa-check{{/if}}"></i>
                                    </button>
                                {{else}}
                                    <i class="fas fa-scroll slot-drop-icon"></i>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                </div>{{!-- /qm-tracker-accordion-scrollable --}}

                {{!-- ── Scroll actions (inside override accordion) ── --}}
                <div class="scroll-compendium-info tracker-accordion-actions">
                    <div class="scroll-compendium-buttons">
                        <button type="button" class="scroll-open-compendium action-open-forged-scrolls" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OpenScrollCompendium'}}">
                            <i class="fas fa-book-open"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.OpenScrollCompendium'}}
                        </button>
                        <a role="button" class="qm-secondary-link action-compile-scroll-forge" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ItemCompiler'}}">
                            <i class="fas fa-hammer"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.ItemCompiler'}}
                        </a>
                    </div>
                    <p class="scroll-jitter-note">
                        {{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ScrollJitterNote'}}}
                    </p>
                </div>

            </div>{{!-- /qm-tracker-accordion --}}

            {{/with}}

            <div style="height: 24px; flex-shrink: 0; width: 100%;"></div>
        </div>
    </div>
    {{/if}}


    {{!-- ══ PARTY SHELF ══════════════════════════════════════════ --}}
    {{#if (eq activeTab 'party')}}
    <div class="registry-panel panel-party">
        <div class="ledger-scroll-area cursed-scroll-area party-panel-layout">

            {{#with partyShelfRow}}
            <div class="party-panel-scroll">
            {{!-- ── Party Shelf Policy Dashboard (always visible) ──────── --}}
            <div class="qm-policy-dashboard party-policy-dashboard">
                <div class="party-policy-columns">

                    {{!-- ── Left Column: Rarity Distribution ────── --}}
                    <div class="party-policy-left">
                        <div class="policy-hero-badge">
                            <span class="policy-hero-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyLevel'}}</span>
                            <span class="policy-hero-value">{{../shelfPolicyData.partyLevel}}</span>
                        </div>

                        <div class="policy-bar-chart">
                            {{#each ../shelfPolicyData.distribution}}
                            <div class="policy-bar-col {{this.cssClass}} {{#if this.isOptimal}}policy-bar-optimal{{/if}}">
                                <div class="policy-bar" style="height: {{this.barHeight}}%;"></div>
                                <span class="policy-bar-pct">{{this.percent}}%</span>
                                <span class="policy-bar-label">{{this.label}}</span>
                            </div>
                            {{/each}}
                        </div>

                        <div class="policy-sliders-row">
                            <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ShelfConcentrationTooltip'}}">
                                <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.Concentration'}} <span class="policy-slider-value">{{../shelfConcentration}}</span></label>
                                <input type="range" class="policy-slider action-update-shelf-concentration" min="1" max="5" step="1" value="{{../shelfConcentration}}">
                            </div>
                            <div class="policy-slider-group" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.AttunementBiasTooltip'}}">
                                <label class="policy-slider-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.AttunementBias'}} <span class="policy-slider-value">{{../shelfPolicyData.attunementLabel}}</span></label>
                                <input type="range" class="policy-slider action-update-shelf-attunement" min="0" max="2" step="1" value="{{../shelfAttunementBias}}">
                            </div>
                        </div>
                    </div>

                    {{!-- ── Vertical Divider ────────────────────── --}}
                    <div class="party-policy-divider"></div>

                    {{!-- ── Right Column: Category Mix ──────────── --}}
                    <div class="party-policy-right">
                        <span class="party-category-header">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CategoryMix'}}</span>

                        {{#each ../shelfPolicyData.categoryMix}}
                        <div class="party-category-row {{#unless this.enabled}}is-disabled{{/unless}}">
                            <input type="checkbox" class="party-category-checkbox action-toggle-category"
                                   data-category="{{this.category}}" {{#if this.enabled}}checked{{/if}}>
                            <span class="party-category-dot {{this.cssClass}}"></span>
                            <span class="party-category-name">{{this.label}}</span>
                            <input type="range" class="party-category-slider action-update-category-weight"
                                   data-category="{{this.category}}"
                                   min="0" max="100" step="5"
                                   value="{{this.weight}}"
                                   {{#unless this.enabled}}disabled{{/unless}}>
                            <span class="party-category-weight {{#unless this.enabled}}is-off{{/unless}}">{{#if this.enabled}}{{this.percent}}%{{else}}&mdash;{{/if}}</span>
                        </div>
                        {{/each}}

                        <span class="party-category-note">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.WeightsAutoNormalise'}}</span>

                        <div class="party-shelf-loot-config-note">
                            <i class="fas fa-circle-info"></i>
                            <span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyShelfConfigNote'}}</span>
                            <a role="button" class="party-shelf-loot-config-link action-open-loot-generation-config">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OpenConfig'}}</a>
                        </div>
                    </div>
                </div>

                <div class="dashboard-footer-actions">
                    <div style="display: flex; justify-content: flex-end; margin-bottom: 4px;">
                        <a role="button" class="btn-qm-reset action-reset-party-defaults" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ResetPartyDefaults'}}">
                            <i class="fas fa-undo"></i>
                        </a>
                    </div>
                    <button type="button" class="btn-qm-override action-toggle-party-tracker {{#if ../partyTrackerExpanded}}is-expanded{{/if}}">
                        <i class="fas {{#if ../partyTrackerExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
                        {{#if ../partyTrackerExpanded}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CollapseTracker'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.OverrideOnSpecificItems'}}{{/if}}
                    </button>
                </div>
            </div>

            {{!-- ── Accordion: tracker grid expands below dashboard ─── --}}
            <div class="qm-tracker-accordion {{#if ../partyTrackerExpanded}}qm-tracker-accordion-open{{/if}}">

                <div class="qm-tracker-accordion-scrollable">
                    {{!-- ── Party Shelf Section Header ───────────────────────── --}}
                    <div class="scroll-section-header party-shelf-header">
                        <div class="scroll-section-header-row">
                            <span class="scroll-section-title"><i class="fas fa-users"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyItems'}}</span>
                        </div>
                    </div>

                    <span class="scroll-section-hint qm-accordion-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyBoardHint1'}}<strong class="hint-highlight">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyBoardHint2'}}</strong>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyBoardHint3'}}</span>

                    {{#unless ../hasParty}}
                    <div class="no-party-notice">
                        <i class="fas fa-users-slash"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.NoPartyReachBand'}}
                    </div>
                    {{/unless}}

                    <div class="cursed-planned-strip-wrap party-planned-strip-wrap">
                        <div class="cursed-planned-col-labels party-planned-col-labels">
                            <div class="cursed-planned-col-labels-grid">
                                {{#each milestoneLabels}}
                                <div class="cursed-planned-col-label party-planned-col-label" style="opacity: {{this.labelFade}};">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=this.level}}</div>
                                {{/each}}
                            </div>
                            <div class="cursed-planned-median-overlay">
                                <div class="cursed-planned-median-track" style="width: {{levelRangeBarPct}}%;">
                                    <span class="cursed-band-level-tip party-band-level-tip">{{partyLevelLabel}}</span>
                                </div>
                            </div>
                        </div>

                        <div class="cursed-planned-band-row party-planned-band-row">
                            <div class="sig-row-level-range cursed-row-level-range party-row-level-range" aria-hidden="true">
                                <div class="sig-row-level-range-fill cursed-level-range-fill party-level-range-fill" style="width: {{levelRangeBarPct}}%;"></div>
                            </div>
                        </div>

                        <div class="sig-slots-strip cursed-slots-strip party-slots-strip">
                            {{#each columns}}
                            <div class="cursed-milestone-stack party-milestone-stack">
                                {{#each this.slots}}
                                {{> "modules/ionrift-quartermaster/templates/partials/slot-cell.hbs" this variant="party"}}
                                {{/each}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>{{!-- /qm-tracker-accordion-scrollable --}}

                {{!-- ── Party Shelf actions (inside override accordion) ── --}}
                <div class="scroll-compendium-info party-compendium-info tracker-accordion-actions">
                    <div class="scroll-compendium-buttons party-compendium-buttons">
                        <button type="button" class="scroll-open-compendium action-seed-shelf" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RandomisePartyItems'}}">
                            <i class="fas fa-wand-magic-sparkles"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.Randomise'}}
                        </button>
                        <a role="button" class="qm-secondary-link action-curate-shelf" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CurateShelf'}}">
                            <i class="fas fa-hammer"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.ItemCompiler'}}
                        </a>
                    </div>
                    <p class="scroll-jitter-note party-jitter-note">
                        {{{localize 'IONRIFT.QUARTERMASTER.LEDGER.PartyJitterNote'}}}
                    </p>
                </div>

            </div>{{!-- /qm-tracker-accordion --}}

            </div>{{!-- /party-panel-scroll --}}

            {{/with}}
        </div>
    </div>
    {{/if}}


    {{!-- ══ BAN LIST ═════════════════════════════════════════════ --}}
    {{#if (eq activeTab 'banlist')}}
    <div class="registry-panel panel-banlist">
        <p class="tab-desc"><i class="fas fa-ban"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.BanListDesc'}}</p>

        <div class="ban-drop-zone" data-drop-target="banlist">
            <i class="fas fa-arrow-down-to-bracket ban-drop-icon"></i>
            <span class="ban-drop-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.DropItemsToBan'}}</span>
            <span class="ban-drop-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.DragFromCompendium'}}</span>
        </div>

        <div class="banlist-toolbar">
            <div class="ban-search-wrapper">
                <i class="fas fa-search ban-search-icon"></i>
                <input type="text" class="ban-search-input" placeholder="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.FilterBanned'}}" />
            </div>
            {{#if banCount}}<span class="ban-count-badge">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.BannedCount' count=banCount}}</span>{{/if}}
        </div>

        <div class="banlist-scroll-area">
            <div class="ban-card-grid">
                {{#each banList}}
                <div class="ban-card" data-index="{{@index}}" data-name="{{this.name}}">
                    <button type="button" class="ban-card-remove action-remove-ban" data-index="{{@index}}" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RemoveFromBanList'}}">
                        <i class="fas fa-times"></i>
                    </button>
                    <div class="ban-card-icon">
                        {{#if this.img}}
                        <img src="{{this.img}}" class="ban-card-img" alt="{{this.name}}" />
                        {{else}}
                        <i class="fas fa-ban ban-card-placeholder"></i>
                        {{/if}}
                    </div>
                    <span class="ban-card-name" title="{{this.name}}">{{this.name}}</span>
                </div>
                {{/each}}
            </div>

            {{#unless banCount}}
            <div class="empty-state ban-empty-state">
                <i class="fas fa-thumbs-up"></i>
                <p>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.NoItemsBanned'}}</p>
            </div>
            {{/unless}}

            <div class="ban-no-matches" style="display:none;">
                <i class="fas fa-search"></i>
                <p>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.NoBannedMatch'}}</p>
            </div>
        </div>

    </div>
    {{/if}}

{{#if (eq activeTab 'cursed')}}
<div class="registry-panel panel-cursed">
    <div class="ledger-scroll-area cursed-scroll-area cursed-priority-layout">

        {{!-- ── Compact header bar ────────────────────────────────────────── --}}
        <div class="curse-header-bar">
            <div class="curse-header-left">
                <i class="fas fa-flask-vial"></i>
                <span class="curse-header-title">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CursedPool'}}</span>
                <span class="curse-header-sub">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CursedPoolSub'}}</span>
            </div>
            <div class="curse-header-right">
                {{#unless cwPresent}}
                <span class="curse-cw-signal" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CursewrightNotLoadedTooltip'}}">
                    <span class="curse-cw-dot">◦</span> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.CursewrightNotLoaded'}}
                </span>
                {{/unless}}
                {{#if cwPresent}}
                <button type="button" class="btn-cursed-tracker-launch action-open-curse-registry"
                        title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ViewCurseTracker'}}">
                    <i class="fas fa-eye"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.CurseTracker'}}
                </button>
                {{/if}}
                <span class="curse-header-level">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LevelCol' level=partyLevel}}</span>
            </div>
        </div>

        {{!-- ── Tier distribution chart ────────────────────────────────────── --}}
        <div class="curse-tier-dist-panel">
            <span class="curse-dist-label">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.DropProbability' level=partyLevel}}</span>
            <div class="curse-dist-chart-group">
                <div class="curse-dist-bars">
                    {{#each cursedTierDistribution}}
                    <div class="curse-dist-col {{#if this.isDisabled}}curse-dist-col--off{{/if}}">
                        <div class="curse-dist-bar" style="height: {{this.barHeight}}px;"></div>
                        <span class="curse-dist-pct">{{#if this.isDisabled}}-{{else}}{{this.percent}}%{{/if}}</span>
                        <span class="curse-dist-tier-label">{{this.label}}</span>
                    </div>
                    {{/each}}
                </div>
                <div class="curse-dist-vert-divider"></div>
                <div class="curse-tier-toggles">
                    <label class="curse-tier-toggle-row {{#unless t3Enabled}}curse-toggle-off{{/unless}}" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.T3Tooltip'}}">
                        <input type="checkbox" class="curse-tier-toggle-check action-toggle-t3" {{#if t3Enabled}}checked{{/if}}>
                        <span class="curse-toggle-tier">T3</span>
                        <span class="curse-toggle-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.T3Hint'}}</span>
                    </label>
                    <label class="curse-tier-toggle-row {{#unless t4Enabled}}curse-toggle-off{{/unless}}" title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.T4Tooltip'}}">
                        <input type="checkbox" class="curse-tier-toggle-check action-toggle-t4" {{#if t4Enabled}}checked{{/if}}>
                        <span class="curse-toggle-tier">T4</span>
                        <span class="curse-toggle-hint">{{localize 'IONRIFT.QUARTERMASTER.LEDGER.T4Hint'}}</span>
                    </label>
                </div>
            </div>
        </div>

        {{!-- ── Priority columns ────────────────────────────────────────────── --}}
        <div class="curse-priority-grid">
            {{#each priorityColumns}}
            <div class="curse-priority-col {{#unless this.enabled}}curse-priority-col--disabled{{/unless}}"
                 data-tier="{{this.tier}}">

                <div class="curse-priority-col-head">
                    <span class="curse-col-label">{{this.laneHead}}</span>
                    <span class="curse-col-count {{#if this.isFull}}curse-col-count--full{{/if}}">{{this.count}}/{{../priorityColCap}}</span>
                </div>

                {{#unless this.enabled}}
                <div class="curse-col-disabled-notice">
                    <i class="fas fa-lock"></i>
                    <span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.TierDisabled'}}</span>
                </div>
                {{/unless}}

                {{#if this.enabled}}
                    {{#each this.items}}
                    <div class="curse-priority-card"
                         data-uuid="{{this.uuid}}"
                         data-tier="{{../tier}}"
                         data-pos-in-col="{{this.posInCol}}"
                         draggable="true"
                         title="{{this.weightLabel}}{{#if this.curseTypeDesc}} · {{this.curseTypeDesc}}{{/if}}">
                        <span class="curse-card-weight-badge" title="{{this.weightTooltip}}">{{this.weightPct}}%</span>
                        <div class="curse-card-icon">
                            {{#if this.img}}
                            <img src="{{this.img}}" class="curse-card-img" alt="{{this.name}}" draggable="false" />
                            {{else}}
                            <i class="fas fa-flask-vial curse-card-placeholder"></i>
                            {{/if}}
                        </div>
                        <div class="curse-card-body">
                            <span class="curse-card-name" title="{{this.name}}">{{this.name}}</span>
                            {{#if this.curseType}}<span class="curse-card-type" title="{{this.curseTypeDesc}}">{{this.curseType}}</span>{{/if}}
                        </div>
                        <button type="button" class="curse-priority-card-remove action-remove-pool-item"
                                data-index="{{this.posInCol}}"
                                data-uuid="{{this.uuid}}"
                                title="{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RemoveFromPool'}}">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    {{/each}}

                    {{#unless this.isFull}}
                    <div class="curse-col-drop-hint">
                        <i class="fas fa-arrow-down-to-bracket"></i>
                        <span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.DropItemHere'}}</span>
                    </div>
                    {{/unless}}

                    {{#if this.isFull}}
                    <div class="curse-col-full-notice">
                        <i class="fas fa-circle-info"></i>
                        <span>{{localize 'IONRIFT.QUARTERMASTER.LEDGER.ColumnFull'}}</span>
                    </div>
                    {{/if}}
                {{/if}}

            </div>
            {{/each}}
        </div>

        {{!-- ── Source footer ─────────────────────────────────────────────── --}}
        <div class="curse-source-footer">
            <div class="curse-source-footer-left">
                {{#unless cwPresent}}
                {{#if srdPoolCount}}
                <span class="curse-source-pill curse-source-pill--active">
                    <i class="fas fa-circle-check"></i> {{#if (gt srdPoolCount 1)}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SRDItemsPlural' count=srdPoolCount}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.SRDItems' count=srdPoolCount}}{{/if}}
                </span>
                {{else}}
                <span class="curse-source-pill">
                    <i class="fas fa-flask-vial"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.SRDNotLoaded'}}
                </span>
                {{/if}}
                {{/unless}}
                {{#if cwPresent}}
                    {{#if cwPoolCount}}
                    <span class="curse-source-pill curse-source-pill--active">
                        <i class="fas fa-circle-check"></i> {{#if (gt cwPoolCount 1)}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CWItemsPlural' count=cwPoolCount}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CWItems' count=cwPoolCount}}{{/if}}
                    </span>
                    {{else}}
                    <span class="curse-source-pill">
                        <i class="fas fa-skull-crossbones"></i> {{localize 'IONRIFT.QUARTERMASTER.LEDGER.CWNotCompiled'}}
                    </span>
                    {{/if}}
                {{/if}}
            </div>
            <div class="curse-source-footer-right">
                {{#unless cwPresent}}
                {{#if hasSrdPack}}
                <a role="button" class="curse-footer-link action-compile-srd-cursed"
                   data-action="compile-srd-cursed"
                   title="{{#if srdPoolCount}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RefreshSRDTooltip'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LoadSRDTooltip'}}{{/if}}">
                    <i class="fas {{#if srdPoolCount}}fa-rotate{{else}}fa-plus{{/if}}"></i>
                    {{#if srdPoolCount}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RefreshSRD'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.LoadSRD'}}{{/if}}
                </a>
                {{/if}}
                {{/unless}}
                {{#if cwPresent}}
                <a role="button" class="curse-footer-link action-compile-curse-forge"
                   data-action="compile-curse-forge"
                   title="{{#if cwPoolCount}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RefreshCWTooltip'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CompileCWTooltip'}}{{/if}}">
                    <i class="fas {{#if cwPoolCount}}fa-rotate{{else}}fa-hammer{{/if}}"></i>
                    {{#if cwPoolCount}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.RefreshCW'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.LEDGER.CompileCW'}}{{/if}}
                </a>
                {{/if}}
            </div>
        </div>

    </div>
</div>
{{/if}}

</form>
