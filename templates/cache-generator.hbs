<form class="ionrift-cache-generator">
    <div class="cache-split-layout {{#if advisory}}has-advisory{{/if}}">

        {{!-- LEFT PANEL  --  Progression Advisory (only renders when data exists) --}}
        {{#if advisory}}
        <div class="cache-advisory {{#if advisoryCollapsed}}advisory-strip{{/if}}">

            {{!-- Collapsed strip view --}}
            {{#if advisoryCollapsed}}
            <div class="advisory-strip-bar action-toggle-advisory" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.ExpandAdvisory'}}">
                <i class="fas fa-bolt advisory-strip-bolt"></i>

                {{!-- Character portraits needing attention --}}
                {{#each advisory.characters}}
                <div class="strip-avatar-slot" title="{{this.actorName}}">
                    <img src="{{this.actorImg}}" class="strip-avatar" alt="{{this.actorName}}" />
                    {{#if this.plannedItem}}
                    <img src="{{this.plannedItem.img}}" class="strip-item-pip" alt="{{this.plannedItem.name}}" title="{{this.plannedItem.name}} ({{localize 'IONRIFT.QUARTERMASTER.CACHE.Level' level=this.plannedItem.level}})" />
                    {{/if}}
                </div>
                {{/each}}

                {{!-- Party shelf count --}}
                {{#if advisory.hasPartyShelf}}
                <div class="strip-count-badge strip-shelf-badge" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.PartyShelfItems'}}">
                    <i class="fas fa-box-open"></i>
                    <span>{{advisory.partyShelf.length}}</span>
                </div>
                {{/if}}

                {{!-- Cursed pool count --}}
                {{#if advisory.hasCursedPool}}
                <div class="strip-count-badge strip-cursed-badge" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedItems'}}">
                    <i class="fas fa-skull"></i>
                    <span>{{advisory.cursedPool.length}}</span>
                </div>
                {{/if}}

                {{#if advisory.hasScrolls}}
                <div class="strip-count-badge strip-scroll-badge" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.ScrollPlanPins'}}">
                    <i class="fas fa-scroll"></i>
                    <span>{{advisory.scrolls.length}}</span>
                </div>
                {{/if}}
            </div>
            {{else}}

            {{!-- Expanded advisory --}}
            <div class="advisory-column-header action-toggle-advisory" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CollapseAdvisory'}}">
                <span class="advisory-column-title">
                    <i class="fas fa-bolt"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.ProgressionAdvisory'}}
                </span>
                <i class="fas fa-chevron-left advisory-collapse-icon"></i>
            </div>

            <div class="advisory-column-body">

                {{!-- CHARACTER MILESTONE CARDS --}}
                {{#if advisory.characters.length}}
                <div class="advisory-sub-section advisory-signatures-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-star"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.Signatures'}}</span>
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.characters}}
                        <div class="advisory-character-card">
                            <div class="advisory-card-header">
                                <img src="{{this.actorImg}}" class="advisory-card-portrait" alt="{{this.actorName}}" />
                                <div class="advisory-card-identity">
                                    <span class="advisory-card-name">{{this.actorName}}</span>
                                    {{#if this.reason}}<span class="advisory-card-reason">{{this.reason}}</span>{{/if}}
                                </div>
                            </div>
                            {{#if this.plannedItem}}
                            <div class="advisory-card-item" draggable="true" data-uuid="{{this.plannedItem.uuid}}" data-item-name="{{this.plannedItem.name}}">
                                {{#if this.plannedItem.img}}<img src="{{this.plannedItem.img}}" class="advisory-card-item-img" />{{/if}}
                                <span class="advisory-card-item-name">{{this.plannedItem.name}}</span>
                                <span class="advisory-card-item-level">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Level' level=this.plannedItem.level}}</span>
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{!-- SCROLL PLAN (milestone pins; same row pattern as Party Shelf, drag into cache) --}}
                {{#if advisory.hasScrolls}}
                <div class="advisory-sub-section advisory-scroll-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-scroll"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.ScrollPlan'}}</span>
                        {{#if advisory.scrollCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="scroll" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollScrolls'}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.scrolls}}
                        <div class="shelf-item shelf-item--scroll shelf-item--planned {{#if this.isRipe}}shelf-item--ripe{{/if}}"
                            draggable="{{#if this.canInject}}true{{else}}false{{/if}}"
                            data-uuid="{{this.uuid}}"
                            data-level="{{this.level}}"
                            data-spell-name="{{this.spellName}}"
                            data-spell-level="{{this.spellLevel}}"
                            title="{{#if @root.hasResult}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.DragIntoCache'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.GenerateFirstThenDrag'}}{{/if}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.GateLevelReached'}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.spellName}}</span>
                                <span class="shelf-item-sub">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Circle' level=this.spellLevel}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Level' level=this.level}}</span>{{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{!-- PARTY SHELF (Enrich Hoard domain list) --}}
                {{#if advisory.hasPartyShelf}}
                <div class="advisory-sub-section advisory-party-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-box-open"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.PartyShelf'}}</span>
                        {{#if advisory.partyShelfCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="partyShelf" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollPartyShelf'}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.partyShelf}}
                        <div class="shelf-item {{#if this.isPlanned}}shelf-item--planned{{/if}} {{#if this.isRipe}}shelf-item--ripe{{/if}}" draggable="true" data-uuid="{{this.uuid}}" {{#if this.level}}data-level="{{this.level}}"{{/if}} title="{{#if this.isRipe}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.RipePartyAtGate'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.DragIntoCache'}}{{/if}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.GateLevelReached'}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.name}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Level' level=this.level}}</span>{{/if}}
                        </div>
                        {{/each}}

                    </div>
                </div>
                {{/if}}

                {{!-- CURSED POOL (Curse Cache domain list) --}}
                {{#if advisory.hasCursedPool}}
                <div class="advisory-sub-section advisory-cursed-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-skull"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedPool'}}</span>
                        {{#if advisory.cursedCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="cursedPool" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollCursedPool'}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.cursedPool}}
                        <div class="shelf-item shelf-item--cursed {{#if this.isPlanned}}shelf-item--planned{{/if}} {{#if this.isRipe}}shelf-item--ripe{{/if}}"
                            draggable="true"
                            data-uuid="{{this.uuid}}"
                            {{#if this.level}}data-level="{{this.level}}"{{/if}}
                            title="{{#if this.isRipe}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.RipePartyAtGate'}}{{else}}{{#if this.decoyAppearance}}{{this.decoyAppearance}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.DragIntoCache'}}{{/if}}{{/if}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.GateLevelReached'}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.name}}</span>
                                <span class="shelf-item-sub">{{this.curseType}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Level' level=this.level}}</span>{{/if}}
                        </div>
                        {{/each}}

                    </div>
                </div>
                {{/if}}

                {{!-- Campaign pacing slot (reserved) --}}
                {{!-- <div class="advisory-pacing">...</div> --}}
            </div>

            <div class="advisory-column-footer">
                <i class="fas fa-masks-theater"></i>
                {{localize 'IONRIFT.QUARTERMASTER.CACHE.DragItemsWhenRight'}}
            </div>

            {{/if}}
        </div>
        {{/if}}


        {{!-- CENTER PANEL  --  Config + Item List --}}
        <div class="cache-center">

            {{!-- Controls --}}
            <div class="cache-controls">

                {{!-- Secondary context strip: Tier + Terrain (last-used, low priority) --}}
                <div class="context-strip">
                    <div class="context-pill">
                        <i class="fas fa-layer-group"></i>
                        <select name="tier" class="context-select">
                            <option value="1" {{#if tierIs1}}selected{{/if}}>{{localize 'IONRIFT.QUARTERMASTER.CACHE.Tier1'}}</option>
                            <option value="2" {{#if tierIs2}}selected{{/if}}>{{localize 'IONRIFT.QUARTERMASTER.CACHE.Tier2'}}</option>
                            <option value="3" {{#if tierIs3}}selected{{/if}}>{{localize 'IONRIFT.QUARTERMASTER.CACHE.Tier3'}}</option>
                            <option value="4" {{#if tierIs4}}selected{{/if}}>{{localize 'IONRIFT.QUARTERMASTER.CACHE.Tier4'}}</option>
                        </select>
                    </div>
                    <div class="context-strip-divider"></div>
                    <div class="context-pill">
                        <i class="fas fa-mountain"></i>
                        <select name="theme" class="context-select">
                            {{#each themeOptionGroups}}
                            <optgroup label="{{group}}">
                                {{#each options}}
                                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                        </select>
                    </div>
                </div>

                {{!-- Hero: Owner (the primary creative choice) --}}
                <div class="owner-hero-group">
                    <label class="owner-hero-label">
                        <i class="fas fa-skull-crossbones"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.CacheOrigin'}}
                    </label>
                    <select name="ownerTheme" class="owner-hero-select">
                        {{#each ownerThemes}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <div class="cache-type-guidance">
                        {{#each ownerThemes}}
                        <span class="guidance-text guidance-{{this.id}}" style="display: {{#if this.selected}}inline{{else}}none{{/if}};">{{this.desc}}</span>
                        {{/each}}
                    </div>
                </div>

            </div>

            {{!-- Results --}}
            {{#if hasResult}}
            <div class="cache-results visible drop-target">


                <div class="results-header">
                    <h3><i class="fas fa-treasure-chest"></i> {{meta.cacheLabel}}</h3>
                    <span class="results-meta">{{meta.tierLabel}} | {{themeLabel}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.ItemsCount' count=itemCount}}</span>
                </div>

                <div class="cache-gold-bar">
                    <div class="cache-gold-chips">
                        {{#if gold}}
                        {{#if coinage}}
                            {{#if coinage.pp}}<span class="coin-chip coin-pp"><i class="fas fa-circle"></i> {{coinage.pp}} pp</span>{{/if}}
                            {{#if coinage.gp}}<span class="coin-chip coin-gp"><i class="fas fa-circle"></i> {{coinage.gp}} gp</span>{{/if}}
                            {{#if coinage.ep}}<span class="coin-chip coin-ep"><i class="fas fa-circle"></i> {{coinage.ep}} ep</span>{{/if}}
                            {{#if coinage.sp}}<span class="coin-chip coin-sp"><i class="fas fa-circle"></i> {{coinage.sp}} sp</span>{{/if}}
                            {{#if coinage.cp}}<span class="coin-chip coin-cp"><i class="fas fa-circle"></i> {{coinage.cp}} cp</span>{{/if}}
                        {{else}}
                            <span class="coin-chip coin-gp"><i class="fas fa-circle"></i> {{gold}} gp</span>
                        {{/if}}
                        {{else}}
                        <span class="cache-gold-empty">{{localize 'IONRIFT.QUARTERMASTER.CACHE.NoCoinage'}}</span>
                        {{/if}}
                    </div>
                    <div class="cache-gold-actions">
                        <button type="button" class="action-reroll-gold reroll-btn" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollGold'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-clear-gold remove-btn" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.ClearGold'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>

                {{!-- Special Items (Signatures / Party Shelf / Cursed injections) --}}
                {{#if hasSpecial}}
                <div class="cache-section cache-special-section">
                    <div class="section-label special-label">
                        <i class="fas fa-sparkles"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.SpecialItems'}}
                    </div>

                    {{!-- Signatures sub-group --}}
                    {{#if specialSigs.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label"><i class="fas fa-star"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.Signatures'}}</div>
                        {{#each specialSigs}}
                        <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}} | {{this.rarity}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}</span>
                                <span class="cache-item-meta">{{#if this.priceLabel}}{{this.priceLabel}}{{/if}}{{#if this.rarity}} &bull; {{this.rarity}}{{/if}}</span>
                            </div>
                            <div class="cache-item-badges">
                                {{#if this.cursed}}<span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>{{/if}}
                                {{#if this._isMagical}}<span class="magic-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.MagicalUntilIdentified' name=this._baseItemName}}"><i class="fas fa-wand-sparkles"></i></span>{{/if}}
                            </div>
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Party Shelf sub-group --}}
                    {{#if specialShelf.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label"><i class="fas fa-box-open"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.PartyShelf'}}</div>
                        {{#each specialShelf}}
                        <div class="cache-item-row special-shelf-row"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}} | {{this.rarity}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}</span>
                                <span class="cache-item-meta">{{#if this.priceLabel}}{{this.priceLabel}}{{/if}}{{#if this.rarity}} &bull; {{this.rarity}}{{/if}}</span>
                            </div>
                            <div class="cache-item-badges">
                                {{#if this._isMagical}}<span class="magic-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.MagicalUntilIdentified' name=this._baseItemName}}"><i class="fas fa-wand-sparkles"></i></span>{{/if}}
                            </div>
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Cursed sub-group --}}
                    {{#if specialCursed.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label special-sub-label--cursed"><i class="fas fa-skull"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.Cursed'}}</div>
                        {{#each specialCursed}}
                        <div class="cache-item-row cursed-item"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}}{{#if this.cursedAs}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}{{#if this.stacked}} <span class="qty-badge">x{{this.quantity}}</span>{{/if}}</span>
                                <span class="cache-item-meta">{{#if this.rarity}}{{this.rarity}}{{/if}}</span>
                            </div>
                            {{!-- Skull = standard cursed. Droplet = infected potion stack. GM-only in both cases. --}}
                            {{#if this.isInfectedStack}}
                            <span class="cursed-pip cursed-pip--infected" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.InfectedStack' type=this.cursedAs}}">
                                <i class="fas fa-tint"></i>
                            </span>
                            {{else}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Cursed'}}{{#if this.cursedAs}}: {{this.cursedAs}}{{/if}}">
                                <i class="fas fa-skull"></i>
                            </span>
                            {{/if}}
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                </div>
                {{/if}}

                {{!-- Spell Scrolls --}}
                {{#if scrolls.length}}
                <div class="cache-section">
                    <div class="section-label scroll-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.SpellScrolls'}}</div>
                    {{#each scrolls}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.LevelValue' level=this.spellLevel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{localize 'IONRIFT.QUARTERMASTER.CACHE.LevelValue' level=this.spellLevel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.MagicalUntilIdentified' name=this._baseItemName}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="scroll" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Weapons & Armour --}}
                {{#if weapons.length}}
                <div class="cache-section">
                    <div class="section-label weapon-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.WeaponsArmour'}}</div>
                    {{#each weapons}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}} | {{this.rarity}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.MagicalUntilIdentified' name=this._baseItemName}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="mastercraft" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Gemstones --}}
                {{#if gemstones.length}}
                <div class="cache-section">
                    <div class="section-label gemstone-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Gemstones'}}</div>
                    {{#each gemstones}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="gemstone" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Treasure (Art Objects, Trade Goods, Coin Finds) --}}
                {{#if treasures.length}}
                <div class="cache-section">
                    <div class="section-label treasure-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Treasure'}}</div>
                    {{#each treasures}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="treasure" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Consumables --}}
                {{#if consumables.length}}
                <div class="cache-section">
                    <div class="section-label consumable-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Consumables'}}</div>
                    {{#each consumables}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.MagicalUntilIdentified' name=this._baseItemName}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="consumable" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Trade Goods / Mundane --}}
                {{#if mundane.length}}
                <div class="cache-section">
                    <div class="section-label mundane-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.TradeGoods'}}</div>
                    {{#each mundane}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="mundane" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Trinkets --}}
                {{#if trinkets.length}}
                <div class="cache-section">
                    <div class="section-label mundane-label">{{localize 'IONRIFT.QUARTERMASTER.CACHE.Trinkets'}}</div>
                    {{#each trinkets}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.CursedAs' type=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="trinket" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Reroll'}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.Remove'}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

            </div>
            {{else}}
                {{#unless generating}}
                {{#if hasLootPool}}
                <div class="cache-empty-state">
                    <i class="fas fa-treasure-chest"></i>
                    <p>{{localize 'IONRIFT.QUARTERMASTER.CACHE.EmptyStateConfigure'}}</p>
                    <p class="cache-hint">{{localize 'IONRIFT.QUARTERMASTER.CACHE.EmptyStateHint'}}</p>
                </div>
                {{else}}
                <div class="cache-empty-state cache-no-pool-state">
                    <i class="fas fa-box-open"></i>
                    <p>{{localize 'IONRIFT.QUARTERMASTER.CACHE.NoPoolConfigured'}}</p>
                    <p class="cache-hint">{{localize 'IONRIFT.QUARTERMASTER.CACHE.NoPoolHint'}}</p>
                </div>
                {{/if}}
                {{/unless}}
            {{/if}}

            {{!-- Forge warning banner: shown above the footer when compiled pool is stale/missing.
                 Sits between the loot preview and the action footer — contextual, non-intrusive. --}}
            {{#if forgeStalePip}}
            <div class="cache-forge-warning-banner cache-forge-warning--stale"
                 title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.ForgeWarningStale'}}">
                <i class="fas fa-triangle-exclamation"></i>
                <span class="cache-forge-warning-text">{{localize 'IONRIFT.QUARTERMASTER.CACHE.ForgeWarningStale'}}</span>
                <button type="button" class="action-open-forge-from-pip cache-forge-warning-btn">{{localize 'IONRIFT.QUARTERMASTER.CACHE.OpenForge'}} <i class="fas fa-arrow-right"></i></button>
            </div>
            {{/if}}
            {{#if forgeNeverPip}}
            <div class="cache-forge-warning-banner cache-forge-warning--never"
                 title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.ForgeWarningNever'}}">
                <i class="fas fa-hammer"></i>
                <span class="cache-forge-warning-text">{{localize 'IONRIFT.QUARTERMASTER.CACHE.ForgeWarningNever'}}</span>
                <button type="button" class="action-open-forge-from-pip cache-forge-warning-btn">{{localize 'IONRIFT.QUARTERMASTER.CACHE.OpenForge'}} <i class="fas fa-arrow-right"></i></button>
            </div>
            {{/if}}

            {{!-- Sticky footer --}}
            {{#if hasResult}}
            <div class="cache-sticky-footer">

                {{!-- Left zone: slider + est total stacked --}}
                <div class="cache-value-range">
                    <span class="value-range-label-text"><i class="fas fa-coins"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.BudgetRange'}}</span>
                    <div class="value-range-track budget-segments" id="cache-range-track" role="group" aria-label="{{localize 'IONRIFT.QUARTERMASTER.CACHE.BudgetRange'}}">
                        {{#each budgetBrackets}}
                        <button type="button"
                            class="budget-segment{{#if this.selected}} is-selected{{/if}}"
                            data-index="{{@index}}"
                            data-min="{{this.min}}"
                            data-max="{{this.max}}"
                            title="{{this.label}}"
                            aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}">
                        </button>
                        {{/each}}
                        <input type="hidden" name="budgetMin" value="{{budgetMin}}" />
                        <input type="hidden" name="budgetMax" value="{{budgetMax}}" />
                    </div>
                    <div class="cache-budget-footer-row">
                        <span class="budget-range-display">{{budgetRangeLabel}}</span>
                        <div class="cache-total">
                            <i class="fas fa-scale-balanced"></i>
                            {{localize 'IONRIFT.QUARTERMASTER.CACHE.EstTotal'}} <strong>{{totalValueLabel}}</strong>
                        </div>
                    </div>
                </div>

            {{!-- Right zone: dominant reroll button --}}
                <button type="button" class="action-generate cache-btn-reroll-footer" {{#if generating}}disabled{{/if}}>
                    {{#if generating}}
                        <i class="fas fa-spinner fa-spin"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.Generating'}}
                    {{else}}
                        <i class="fas fa-dice"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollCache'}}
                    {{/if}}
                </button>

            </div>
            {{else}}
            <div class="cache-sticky-footer">
                {{#if hasLootPool}}
                <button type="button" class="action-generate cache-btn-primary" {{#if generating}}disabled{{/if}}>
                    {{#if generating}}
                        <i class="fas fa-spinner fa-spin"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.Generating'}}
                    {{else}}
                        <i class="fas fa-treasure-chest"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.GenerateCache'}}
                    {{/if}}
                </button>


                {{else}}
                <button type="button" class="action-open-pool-compiler cache-btn-nudge">
                    <i class="fas fa-hammer"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.SetUpLootPool'}}
                </button>
                {{/if}}
            </div>

            {{/if}}

        </div>{{!-- /.cache-center --}}


        {{!-- RIGHT PANEL -- Container / Delivery --}}
        <div class="cache-right drop-target" id="cache-right-drop-zone">
            {{#if hasResult}}

                {{#if meta.flavor}}
                <div class="cache-flavor-container" style="background: rgba(0, 0, 0, 0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--color-border-dark); margin-bottom: 12px;">
                    <p class="cache-flavor" style="margin: 0; font-family: var(--ionrift-font, inherit); font-style: italic; color: var(--color-text-light-5); text-align: center; font-size: 0.95em;">{{meta.flavor}}</p>
                </div>
                {{/if}}

                {{#if container}}
                {{!-- Container card, draggable when Item Piles is active --}}
                <div class="container-card" draggable="{{itemPilesActive}}" title="{{#if itemPilesActive}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.DragToCanvas'}}{{else}}{{localize 'IONRIFT.QUARTERMASTER.CACHE.ContainerPreview'}}{{/if}}">

                    {{!-- Reroll container button --}}
                    <button type="button" class="action-reroll-container btn-container-reroll" title="{{localize 'IONRIFT.QUARTERMASTER.CACHE.RerollContainer'}}">
                        <i class="fas fa-dice"></i>
                    </button>

                    <img class="container-art" src="{{container.img}}" alt="{{container.name}}" />
                    <div class="container-name">{{container.name}}</div>
                    <div class="container-stats">{{statsLabel}}</div>

                    <div class="capacity-bar">
                        <div class="capacity-fill {{overweightClass}}" style="width: {{fillPct}}%"></div>
                    </div>
                    <div class="capacity-label {{overweightClass}}">{{capacityLabel}}{{#if container.isOverweight}} {{localize 'IONRIFT.QUARTERMASTER.CACHE.OverCapacity'}}{{/if}}</div>

                </div>

                {{!-- Primary action --}}
                {{#if itemPilesActive}}
                <p class="drag-hint"><i class="fas fa-hand-grab"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.DragContainerHint'}}</p>
                {{else}}
                <button type="button" class="action-add-items btn-add-items" id="cache-add-items-btn">
                    <i class="fas fa-box-open"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.AddToItems'}}
                </button>
                <p class="drag-hint"><i class="fas fa-circle-info"></i> {{localize 'IONRIFT.QUARTERMASTER.CACHE.InstallItemPiles'}}</p>
                {{/if}}

                {{else}}
                {{!-- No container matched yet --}}
                <div class="container-placeholder">
                    <i class="fas fa-box"></i>
                    <p>{{localize 'IONRIFT.QUARTERMASTER.CACHE.NoContainerMatched'}}<br>{{localize 'IONRIFT.QUARTERMASTER.CACHE.TryRerolling'}}</p>
                </div>
                {{/if}}

            {{else}}
            {{!-- No result yet --}}
            <div class="container-placeholder">
                <i class="fas fa-treasure-chest"></i>
                <p>{{localize 'IONRIFT.QUARTERMASTER.CACHE.GenerateToSee'}}<br>{{localize 'IONRIFT.QUARTERMASTER.CACHE.ToSeeContainer'}}</p>
            </div>
            {{/if}}
        </div>{{!-- /.cache-right --}}

    </div>{{!-- /.cache-split-layout --}}
</form>
