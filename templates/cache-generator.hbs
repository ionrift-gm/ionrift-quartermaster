<form class="ionrift-cache-generator">
    <div class="cache-split-layout {{#if advisory}}has-advisory{{/if}}">

        {{!-- LEFT PANEL  --  Progression Advisory (only renders when data exists) --}}
        {{#if advisory}}
        <div class="cache-advisory {{#if advisoryCollapsed}}advisory-strip{{/if}}">

            {{!-- Collapsed strip view --}}
            {{#if advisoryCollapsed}}
            <div class="advisory-strip-bar action-toggle-advisory" title="{{localize "ionrift-quartermaster.cacheGenerator.expandAdvisory"}}">
                <i class="fas fa-bolt advisory-strip-bolt"></i>

                {{!-- Character portraits needing attention --}}
                {{#each advisory.characters}}
                <div class="strip-avatar-slot" title="{{this.actorName}}">
                    <img src="{{this.actorImg}}" class="strip-avatar" alt="{{this.actorName}}" />
                    {{#if this.plannedItem}}
                    <img src="{{this.plannedItem.img}}" class="strip-item-pip" alt="{{this.plannedItem.name}}" title="{{this.plannedItem.name}} (Lv{{this.plannedItem.level}})" />
                    {{/if}}
                </div>
                {{/each}}

                {{!-- Party shelf count --}}
                {{#if advisory.hasPartyShelf}}
                <div class="strip-count-badge strip-shelf-badge" title="{{localize "ionrift-quartermaster.cacheGenerator.partyShelfAvailable"}}">
                    <i class="fas fa-box-open"></i>
                    <span>{{advisory.partyShelf.length}}</span>
                </div>
                {{/if}}

                {{!-- Cursed pool count --}}
                {{#if advisory.hasCursedPool}}
                <div class="strip-count-badge strip-cursed-badge" title="{{localize "ionrift-quartermaster.cacheGenerator.cursedItemsOnOffer"}}">
                    <i class="fas fa-skull"></i>
                    <span>{{advisory.cursedPool.length}}</span>
                </div>
                {{/if}}

                {{#if advisory.hasScrolls}}
                <div class="strip-count-badge strip-scroll-badge" title="{{localize "ionrift-quartermaster.cacheGenerator.scrollPlanPinsInTier"}}">
                    <i class="fas fa-scroll"></i>
                    <span>{{advisory.scrolls.length}}</span>
                </div>
                {{/if}}
            </div>
            {{else}}

            {{!-- Expanded advisory --}}
            <div class="advisory-column-header action-toggle-advisory" title="{{localize "ionrift-quartermaster.cacheGenerator.collapseAdvisory"}}">
                <span class="advisory-column-title">
                    <i class="fas fa-bolt"></i> {{localize "ionrift-quartermaster.cacheGenerator.progressionAdvisory"}}
                </span>
                <i class="fas fa-chevron-left advisory-collapse-icon"></i>
            </div>

            <div class="advisory-column-body">

                {{!-- CHARACTER MILESTONE CARDS --}}
                {{#if advisory.characters.length}}
                <div class="advisory-sub-section advisory-signatures-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-star"></i> {{localize "ionrift-quartermaster.cacheGenerator.signatures"}}</span>
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.characters}}
                        <div class="advisory-character-card">
                            <div class="advisory-card-header">
                                <img src="{{this.actorImg}}" class="advisory-card-portrait" alt="{{this.actorName}}" />
                                <div class="advisory-card-identity">
                                    <span class="advisory-card-name">{{this.actorName}}</span>
                                    {{#if this.reason}}<span class="advisory-card-reason">{{this.reason}}</span>{{/if}}
                                </div>
                            </div>
                            {{#if this.plannedItem}}
                            <div class="advisory-card-item" draggable="true" data-uuid="{{this.plannedItem.uuid}}" data-item-name="{{this.plannedItem.name}}">
                                {{#if this.plannedItem.img}}<img src="{{this.plannedItem.img}}" class="advisory-card-item-img" />{{/if}}
                                <span class="advisory-card-item-name">{{this.plannedItem.name}}</span>
                                <span class="advisory-card-item-level">Lv{{this.plannedItem.level}}</span>
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{!-- SCROLL PLAN (milestone pins; same row pattern as Party Shelf, drag into cache) --}}
                {{#if advisory.hasScrolls}}
                <div class="advisory-sub-section advisory-scroll-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-scroll"></i> {{localize "ionrift-quartermaster.cacheGenerator.scrollPlan"}}</span>
                        {{#if advisory.scrollCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="scroll" title="{{localize "ionrift-quartermaster.cacheGenerator.rerollScrollSuggestions"}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.scrolls}}
                        <div class="shelf-item shelf-item--scroll shelf-item--planned {{#if this.isRipe}}shelf-item--ripe{{/if}}"
                            draggable="{{#if this.canInject}}true{{else}}false{{/if}}"
                            data-uuid="{{this.uuid}}"
                            data-level="{{this.level}}"
                            data-spell-name="{{this.spellName}}"
                            data-spell-level="{{this.spellLevel}}"
                            title="{{#if @root.hasResult}}{{localize "ionrift-quartermaster.cacheGenerator.dragIntoCache"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.generateCacheFirst"}}{{/if}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.gateLevelReached"}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.spellName}}</span>
                                <span class="shelf-item-sub">{{localize "ionrift-quartermaster.cacheGenerator.spellCircle" circle=(concat this.spellLevel "")}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">Lv{{this.level}}</span>{{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{!-- PARTY SHELF (Enrich Hoard domain list) --}}
                {{#if advisory.hasPartyShelf}}
                <div class="advisory-sub-section advisory-party-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-box-open"></i> {{localize "ionrift-quartermaster.cacheGenerator.partyShelf"}}</span>
                        {{#if advisory.partyShelfCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="partyShelf" title="{{localize "ionrift-quartermaster.cacheGenerator.rerollPartyShelfSuggestions"}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.partyShelf}}
                        <div class="shelf-item {{#if this.isPlanned}}shelf-item--planned{{/if}} {{#if this.isRipe}}shelf-item--ripe{{/if}} {{#unless this.uuid}}shelf-item--no-uuid{{/unless}}" draggable="{{#if this.uuid}}true{{else}}false{{/if}}" data-uuid="{{this.uuid}}" {{#if this.level}}data-level="{{this.level}}"{{/if}} title="{{#unless this.uuid}}{{{localize "ionrift-quartermaster.cacheGenerator.notInCompendiums"}}}{{else}}{{#if this.isRipe}}{{localize "ionrift-quartermaster.cacheGenerator.ripePartyGate"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.dragIntoCache"}}{{/if}}{{/unless}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.gateLevelReached"}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.name}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">Lv{{this.level}}</span>{{/if}}
                        </div>
                        {{/each}}

                    </div>
                </div>
                {{/if}}

                {{!-- CURSED POOL (Curse Cache domain list) --}}
                {{#if advisory.hasCursedPool}}
                <div class="advisory-sub-section advisory-cursed-section">
                    <div class="advisory-sub-header">
                        <span><i class="fas fa-skull"></i> {{localize "ionrift-quartermaster.cacheGenerator.cursedPool"}}</span>
                        {{#if advisory.cursedCanReroll}}<button type="button" class="action-reroll-panel-pool advisory-pool-reroll-btn" data-pool="cursedPool" title="{{localize "ionrift-quartermaster.cacheGenerator.rerollCursedPoolSuggestions"}}"><i class="fas fa-dice"></i></button>{{/if}}
                    </div>
                    <div class="advisory-sub-body">
                        {{#each advisory.cursedPool}}
                        <div class="shelf-item shelf-item--cursed {{#if this.isPlanned}}shelf-item--planned{{/if}} {{#if this.isRipe}}shelf-item--ripe{{/if}} {{#unless this.uuid}}shelf-item--no-uuid{{/unless}}"
                            draggable="{{#if this.uuid}}true{{else}}false{{/if}}"
                            data-uuid="{{this.uuid}}"
                            {{#if this.level}}data-level="{{this.level}}"{{/if}}
                            title="{{#if this.isRipe}}{{localize "ionrift-quartermaster.cacheGenerator.ripePartyGate"}}{{else}}{{#if this.decoyAppearance}}{{this.decoyAppearance}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.dragIntoCache"}}{{/if}}{{/if}}">
                            {{#if this.isRipe}}<span class="advisory-ripe-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.gateLevelReached"}}"><i class="fas fa-fire-flame-curved"></i></span>{{/if}}
                            <img src="{{this.img}}" class="shelf-item-img" alt="" />
                            <div class="shelf-item-text">
                                <span class="shelf-item-name">{{this.name}}</span>
                                <span class="shelf-item-sub">{{this.curseType}}</span>
                            </div>
                            {{#if this.level}}<span class="shelf-item-level">Lv{{this.level}}</span>{{/if}}
                        </div>
                        {{/each}}

                    </div>
                </div>
                {{/if}}

                {{!-- Campaign pacing slot (reserved) --}}
                {{!-- <div class="advisory-pacing">...</div> --}}
            </div>

            <div class="advisory-column-footer">
                <i class="fas fa-masks-theater"></i>
                {{localize "ionrift-quartermaster.cacheGenerator.dragItemsAdvisoryFooter"}}
            </div>

            {{/if}}
        </div>
        {{/if}}


        {{!-- CENTER PANEL  --  Config + Item List --}}
        <div class="cache-center">

            {{!-- Controls --}}
            <div class="cache-controls">

                {{!-- Secondary context strip: Tier + Terrain (last-used, low priority) --}}
                <div class="context-strip">
                    <div class="context-pill">
                        <i class="fas fa-layer-group"></i>
                        <select name="tier" class="context-select">
                            <option value="1" {{#if tierIs1}}selected{{/if}}>{{localize "ionrift-quartermaster.cacheGenerator.tier1Option"}}</option>
                            <option value="2" {{#if tierIs2}}selected{{/if}}>{{localize "ionrift-quartermaster.cacheGenerator.tier2Option"}}</option>
                            <option value="3" {{#if tierIs3}}selected{{/if}}>{{localize "ionrift-quartermaster.cacheGenerator.tier3Option"}}</option>
                            <option value="4" {{#if tierIs4}}selected{{/if}}>{{localize "ionrift-quartermaster.cacheGenerator.tier4Option"}}</option>
                        </select>
                    </div>
                    <div class="context-strip-divider"></div>
                    <div class="context-pill">
                        <i class="fas fa-mountain"></i>
                        <select name="theme" class="context-select">
                            {{#each themeOptionGroups}}
                            <optgroup label="{{group}}">
                                {{#each options}}
                                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                        </select>
                    </div>
                </div>

                {{!-- Hero: Owner (the primary creative choice) --}}
                <div class="owner-hero-group">
                    <label class="owner-hero-label">
                        <i class="fas fa-skull-crossbones"></i> {{localize "ionrift-quartermaster.cacheGenerator.cacheOrigin"}}
                    </label>
                    <select name="ownerTheme" class="owner-hero-select">
                        {{#each ownerThemes}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <div class="cache-type-guidance">
                        {{#each ownerThemes}}
                        <span class="guidance-text guidance-{{this.id}}" style="display: {{#if this.selected}}inline{{else}}none{{/if}};">{{this.desc}}</span>
                        {{/each}}
                    </div>
                </div>

            </div>

            {{!-- Results --}}
            {{#if hasResult}}
            <div class="cache-results visible drop-target">


                <div class="results-header">
                    <h3><i class="fas fa-treasure-chest"></i> {{meta.cacheLabel}}</h3>
                    <span class="results-meta">{{localize "ionrift-quartermaster.cacheGenerator.resultsMeta" tier=meta.tierLabel theme=themeLabel count=itemCount}}</span>
                </div>

                <div class="cache-gold-bar">
                    <div class="cache-gold-chips">
                        {{#if gold}}
                        {{#if coinage}}
                            {{#if coinage.pp}}<span class="coin-chip coin-pp"><i class="fas fa-circle"></i> {{coinage.pp}} pp</span>{{/if}}
                            {{#if coinage.gp}}<span class="coin-chip coin-gp"><i class="fas fa-circle"></i> {{coinage.gp}} gp</span>{{/if}}
                            {{#if coinage.ep}}<span class="coin-chip coin-ep"><i class="fas fa-circle"></i> {{coinage.ep}} ep</span>{{/if}}
                            {{#if coinage.sp}}<span class="coin-chip coin-sp"><i class="fas fa-circle"></i> {{coinage.sp}} sp</span>{{/if}}
                            {{#if coinage.cp}}<span class="coin-chip coin-cp"><i class="fas fa-circle"></i> {{coinage.cp}} cp</span>{{/if}}
                        {{else}}
                            <span class="coin-chip coin-gp"><i class="fas fa-circle"></i> {{gold}} gp</span>
                        {{/if}}
                        {{else}}
                        <span class="cache-gold-empty">{{localize "ionrift-quartermaster.cacheGenerator.noCoinage"}}</span>
                        {{/if}}
                    </div>
                    <div class="cache-gold-actions">
                        <button type="button" class="action-reroll-gold reroll-btn" title="{{localize "ionrift-quartermaster.cacheGenerator.rerollGoldTitle"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-clear-gold remove-btn" title="{{localize "ionrift-quartermaster.cacheGenerator.clearGoldTitle"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>

                {{!-- Special Items (Signatures / Party Shelf / Cursed injections) --}}
                {{#if hasSpecial}}
                <div class="cache-section cache-special-section">
                    <div class="section-label special-label">
                        <i class="fas fa-sparkles"></i> {{localize "ionrift-quartermaster.cacheGenerator.specialItems"}}
                    </div>

                    {{!-- Signatures sub-group --}}
                    {{#if specialSigs.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label"><i class="fas fa-star"></i> {{localize "ionrift-quartermaster.cacheGenerator.signatures"}}</div>
                        {{#each specialSigs}}
                        <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}} | {{this.rarity}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}</span>
                                <span class="cache-item-meta">{{#if this.priceLabel}}{{this.priceLabel}}{{/if}}{{#if this.rarity}} &bull; {{this.rarity}}{{/if}}</span>
                            </div>
                            <div class="cache-item-badges">
                                {{#if this.cursed}}<span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>{{/if}}
                                {{#if this._isMagical}}<span class="magic-pip" title="{{{localize "ionrift-quartermaster.cacheGenerator.magicalMaskedTooltip" baseItem=this._baseItemName}}}"><i class="fas fa-wand-sparkles"></i></span>{{/if}}
                            </div>
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Party Shelf sub-group --}}
                    {{#if specialShelf.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label"><i class="fas fa-box-open"></i> {{localize "ionrift-quartermaster.cacheGenerator.partyShelf"}}</div>
                        {{#each specialShelf}}
                        <div class="cache-item-row special-shelf-row"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}} | {{this.rarity}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}</span>
                                <span class="cache-item-meta">{{#if this.priceLabel}}{{this.priceLabel}}{{/if}}{{#if this.rarity}} &bull; {{this.rarity}}{{/if}}</span>
                            </div>
                            <div class="cache-item-badges">
                                {{#if this._isMagical}}<span class="magic-pip" title="{{{localize "ionrift-quartermaster.cacheGenerator.magicalMaskedTooltip" baseItem=this._baseItemName}}}"><i class="fas fa-wand-sparkles"></i></span>{{/if}}
                            </div>
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Cursed sub-group --}}
                    {{#if specialCursed.length}}
                    <div class="special-sub-group">
                        <div class="special-sub-label special-sub-label--cursed"><i class="fas fa-skull"></i> {{localize "ionrift-quartermaster.cacheGenerator.cursed"}}</div>
                        {{#each specialCursed}}
                        <div class="cache-item-row cursed-item"
                            data-source-compendium="{{this.sourceCompendium}}"
                            data-compendium-id="{{this._compendiumId}}"
                            title="{{this.name}}{{#if this.cursedAs}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                            <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                            <div class="cache-item-info">
                                <span class="cache-item-name inspectable">{{this.name}}{{#if this.stacked}} <span class="qty-badge">x{{this.quantity}}</span>{{/if}}</span>
                                <span class="cache-item-meta">{{#if this.rarity}}{{this.rarity}}{{/if}}</span>
                            </div>
                            {{!-- Skull = standard cursed. Droplet = infected potion stack. GM-only in both cases. --}}
                            {{#if this.isInfectedStack}}
                            <span class="cursed-pip cursed-pip--infected" title="{{localize "ionrift-quartermaster.cacheGenerator.infectedStackTooltip" cursedAs=this.cursedAs}}">
                                <i class="fas fa-tint"></i>
                            </span>
                            {{else}}
                            <span class="cursed-pip" title="{{#if this.cursedAs}}{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.cursed"}}{{/if}}">
                                <i class="fas fa-skull"></i>
                            </span>
                            {{/if}}
                            {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                            <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                </div>
                {{/if}}

                {{!-- Spell Scrolls --}}
                {{#if scrolls.length}}
                <div class="cache-section">
                    <div class="section-label scroll-label">{{localize "ionrift-quartermaster.cacheGenerator.spellScrolls"}}</div>
                    {{#each scrolls}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{localize "ionrift-quartermaster.cacheGenerator.levelNumber" level=this.spellLevel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{localize "ionrift-quartermaster.cacheGenerator.levelNumber" level=this.spellLevel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{{localize "ionrift-quartermaster.cacheGenerator.magicalMaskedTooltip" baseItem=this._baseItemName}}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="scroll" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Weapons & Armour --}}
                {{#if weapons.length}}
                <div class="cache-section">
                    <div class="section-label weapon-label">{{{localize "ionrift-quartermaster.cacheGenerator.weaponsAndArmour"}}}</div>
                    {{#each weapons}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}} | {{this.rarity}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{{localize "ionrift-quartermaster.cacheGenerator.magicalMaskedTooltip" baseItem=this._baseItemName}}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="mastercraft" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Gemstones --}}
                {{#if gemstones.length}}
                <div class="cache-section">
                    <div class="section-label gemstone-label">{{localize "ionrift-quartermaster.cacheGenerator.gemstones"}}</div>
                    {{#each gemstones}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="gemstone" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Treasure (Art Objects, Trade Goods, Coin Finds) --}}
                {{#if treasures.length}}
                <div class="cache-section">
                    <div class="section-label treasure-label">{{localize "ionrift-quartermaster.cacheGenerator.treasure"}}</div>
                    {{#each treasures}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="treasure" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Consumables --}}
                {{#if consumables.length}}
                <div class="cache-section">
                    <div class="section-label consumable-label">{{localize "ionrift-quartermaster.cacheGenerator.consumables"}}</div>
                    {{#each consumables}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                            {{#if this._isMagical}}
                            <span class="magic-pip" title="{{{localize "ionrift-quartermaster.cacheGenerator.magicalMaskedTooltip" baseItem=this._baseItemName}}}"><i class="fas fa-wand-sparkles"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="consumable" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Trade Goods / Mundane --}}
                {{#if mundane.length}}
                <div class="cache-section">
                    <div class="section-label mundane-label">{{localize "ionrift-quartermaster.cacheGenerator.tradeGoods"}}</div>
                    {{#each mundane}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="mundane" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{!-- Trinkets --}}
                {{#if trinkets.length}}
                <div class="cache-section">
                    <div class="section-label mundane-label">{{localize "ionrift-quartermaster.cacheGenerator.trinkets"}}</div>
                    {{#each trinkets}}
                    <div class="cache-item-row {{#if this.cursed}}cursed-item{{/if}}"
                        data-source-compendium="{{this.sourceCompendium}}"
                        data-compendium-id="{{this._compendiumId}}"
                        title="{{this.name}} | {{this.priceLabel}}{{#if this.cursed}} | {{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}{{/if}}">
                        <img src="{{this.img}}" width="32" height="32" class="cache-item-icon inspectable" />
                        <div class="cache-item-info">
                            <span class="cache-item-name inspectable">{{this.name}}</span>
                            <span class="cache-item-meta">{{this.priceLabel}}</span>
                        </div>
                        <div class="cache-item-badges">
                            {{#if this.cursed}}
                            <span class="cursed-pip" title="{{localize "ionrift-quartermaster.cacheGenerator.itemCursedAs" cursedAs=this.cursedAs}}"><i class="fas fa-skull"></i></span>
                            {{/if}}
                        </div>
                        {{> "modules/ionrift-quartermaster/templates/partials/cache-qty-stepper.hbs" this}}
                        <button type="button" class="action-reroll-slot reroll-btn" data-slot="trinket" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.reroll"}}">
                            <i class="fas fa-dice"></i>
                        </button>
                        <button type="button" class="action-remove-slot remove-btn" data-uid="{{this._uid}}" data-index="{{this._origIdx}}" data-stack-name="{{this.name}}" data-stack-count="{{this.quantity}}" title="{{localize "ionrift-quartermaster.cacheGenerator.remove"}}">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

            </div>
            {{else}}
                {{#unless generating}}
                {{#if hasLootPool}}
                <div class="cache-empty-state">
                    <i class="fas fa-treasure-chest"></i>
                    <p>{{localize "ionrift-quartermaster.cacheGenerator.emptyConfigureAbove"}}</p>
                    <p class="cache-hint">{{localize "ionrift-quartermaster.cacheGenerator.emptyDragHint"}}</p>
                </div>
                {{else}}
                <div class="cache-empty-state cache-no-pool-state">
                    <i class="fas fa-box-open"></i>
                    <p>{{#if lootSourcesOnly}}{{localize "ionrift-quartermaster.cacheGenerator.noLootSources"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.noLootPool"}}{{/if}}</p>
                    <p class="cache-hint">{{#if lootSourcesOnly}}{{localize "ionrift-quartermaster.cacheGenerator.noLootSourcesHint"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.noLootPoolHint"}}{{/if}}</p>
                </div>
                {{/if}}
                {{/unless}}
            {{/if}}

            {{!-- Forge warning banner: shown above the footer when compiled pool is stale/missing.
                 Sits between the loot preview and the action footer - contextual, non-intrusive. --}}
            {{#if forgeStalePip}}
            <div class="cache-forge-warning-banner cache-forge-warning--stale"
                 title="{{localize "ionrift-quartermaster.cacheGenerator.forgeStaleWarning"}}">
                <i class="fas fa-triangle-exclamation"></i>
                <span class="cache-forge-warning-text">{{localize "ionrift-quartermaster.cacheGenerator.forgeStaleWarning"}}</span>
                <button type="button" class="action-open-forge-from-pip cache-forge-warning-btn">{{localize "ionrift-quartermaster.cacheGenerator.openForge"}} <i class="fas fa-arrow-right"></i></button>
            </div>
            {{/if}}
            {{#if forgeNeverPip}}
            <div class="cache-forge-warning-banner cache-forge-warning--never"
                 title="{{localize "ionrift-quartermaster.cacheGenerator.forgeNeverWarning"}}">
                <i class="fas fa-hammer"></i>
                <span class="cache-forge-warning-text">{{localize "ionrift-quartermaster.cacheGenerator.forgeNeverWarning"}}</span>
                <button type="button" class="action-open-forge-from-pip cache-forge-warning-btn">{{localize "ionrift-quartermaster.cacheGenerator.openForge"}} <i class="fas fa-arrow-right"></i></button>
            </div>
            {{/if}}

            {{!-- Sticky footer --}}
            {{#if hasResult}}
            <div class="cache-sticky-footer">

                {{!-- Left zone: slider + est total stacked --}}
                <div class="cache-value-range">
                    <span class="value-range-label-text"><i class="fas fa-coins"></i> {{localize "ionrift-quartermaster.cacheGenerator.budgetRange"}}</span>
                    <div class="value-range-track budget-segments" id="cache-range-track" role="group" aria-label="{{localize "ionrift-quartermaster.cacheGenerator.budgetRangeAria"}}">
                        {{#each budgetBrackets}}
                        <button type="button"
                            class="budget-segment{{#if this.selected}} is-selected{{/if}}"
                            data-index="{{@index}}"
                            data-min="{{this.min}}"
                            data-max="{{this.max}}"
                            title="{{this.label}}"
                            aria-pressed="{{#if this.selected}}true{{else}}false{{/if}}">
                        </button>
                        {{/each}}
                        <input type="hidden" name="budgetMin" value="{{budgetMin}}" />
                        <input type="hidden" name="budgetMax" value="{{budgetMax}}" />
                    </div>
                    <div class="cache-budget-footer-row">
                        <span class="budget-range-display">{{budgetRangeLabel}}</span>
                        <div class="cache-total">
                            <i class="fas fa-scale-balanced"></i>
                            {{{localize "ionrift-quartermaster.cacheGenerator.estTotal" total=(concat totalValueLabel "")}}}
                        </div>
                    </div>
                </div>

            {{!-- Right zone: dominant reroll button --}}
                <button type="button" class="action-generate cache-btn-reroll-footer" {{#if generating}}disabled{{/if}}>
                    {{#if generating}}
                        <i class="fas fa-spinner fa-spin"></i> {{localize "ionrift-quartermaster.cacheGenerator.generating"}}
                    {{else}}
                        <i class="fas fa-dice"></i> {{localize "ionrift-quartermaster.cacheGenerator.rerollCache"}}
                    {{/if}}
                </button>

            </div>
            {{else}}
            <div class="cache-sticky-footer">
                {{#if hasLootPool}}
                <button type="button" class="action-generate cache-btn-primary" {{#if generating}}disabled{{/if}}>
                    {{#if generating}}
                        <i class="fas fa-spinner fa-spin"></i> {{localize "ionrift-quartermaster.cacheGenerator.generating"}}
                    {{else}}
                        <i class="fas fa-treasure-chest"></i> {{localize "ionrift-quartermaster.cacheGenerator.generateCache"}}
                    {{/if}}
                </button>


                {{else}}
                <button type="button" class="action-open-pool-compiler cache-btn-nudge">
                    <i class="fas fa-hammer"></i> {{#if lootSourcesOnly}}{{localize "ionrift-quartermaster.cacheGenerator.setUpLootSources"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.setUpLootPool"}}{{/if}}
                </button>
                {{/if}}
            </div>

            {{/if}}

        </div>{{!-- /.cache-center --}}


        {{!-- RIGHT PANEL -- Container / Delivery --}}
        <div class="cache-right drop-target" id="cache-right-drop-zone">
            {{#if hasResult}}

                {{#if meta.flavor}}
                <div class="cache-flavor-container" style="background: rgba(0, 0, 0, 0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--color-border-dark); margin-bottom: 12px;">
                    <p class="cache-flavor" style="margin: 0; font-family: var(--ionrift-font, inherit); font-style: italic; color: var(--color-text-light-5); text-align: center; font-size: 0.95em;">{{meta.flavor}}</p>
                </div>
                {{/if}}

                {{#if container}}
                {{!-- Container card, draggable when a deployment path is available --}}
                <div class="container-card" draggable="{{#if itemPilesActive}}true{{else if supportsLootActor}}true{{else}}false{{/if}}" title="{{#if itemPilesActive}}{{localize "ionrift-quartermaster.cacheGenerator.dragToCanvas"}}{{else if supportsLootActor}}{{localize "ionrift-quartermaster.cacheGenerator.dragToCanvasLootActor"}}{{else}}{{localize "ionrift-quartermaster.cacheGenerator.containerPreview"}}{{/if}}">

                    {{!-- Reroll container button --}}
                    <button type="button" class="action-reroll-container btn-container-reroll" title="{{localize "ionrift-quartermaster.cacheGenerator.rerollContainer"}}">
                        <i class="fas fa-dice"></i>
                    </button>

                    <img class="container-art" src="{{container.img}}" alt="{{container.name}}" />
                    <div class="container-name">{{container.name}}</div>
                    <div class="container-stats">{{statsLabel}}</div>

                    <div class="capacity-bar">
                        <div class="capacity-fill {{overweightClass}}" style="width: {{fillPct}}%"></div>
                    </div>
                    <div class="capacity-label {{overweightClass}}">{{capacityLabel}}{{#if container.isOverweight}}  - {{localize "ionrift-quartermaster.cacheGenerator.overCapacity"}}{{/if}}</div>

                </div>

                {{!-- Primary action --}}
                {{#if itemPilesActive}}
                <p class="drag-hint"><i class="fas fa-hand-grab"></i> {{localize "ionrift-quartermaster.cacheGenerator.dragToCanvas"}}</p>
                {{else if supportsLootActor}}
                <p class="drag-hint"><i class="fas fa-hand-grab"></i> {{localize "ionrift-quartermaster.cacheGenerator.dragToCanvasLootActor"}}</p>
                <button type="button" class="action-create-loot-actor btn-secondary-link" id="cache-create-loot-actor-btn" title="{{localize "ionrift-quartermaster.cacheGenerator.createActorOnlyTitle"}}">
                    <i class="fas fa-plus-square"></i> {{localize "ionrift-quartermaster.cacheGenerator.createActorOnly"}}
                </button>
                <button type="button" class="action-add-items btn-secondary-link" id="cache-add-items-btn" title="{{localize "ionrift-quartermaster.cacheGenerator.addToItemsTitle"}}">
                    <i class="fas fa-box-open"></i> {{localize "ionrift-quartermaster.cacheGenerator.addToItems"}}
                </button>
                {{else}}
                <button type="button" class="action-add-items btn-add-items" id="cache-add-items-btn">
                    <i class="fas fa-box-open"></i> {{localize "ionrift-quartermaster.cacheGenerator.addToItems"}}
                </button>
                <p class="drag-hint"><i class="fas fa-circle-info"></i> {{localize "ionrift-quartermaster.cacheGenerator.installItemPilesHint"}}</p>
                {{/if}}

                {{else}}
                {{!-- No container matched yet --}}
                <div class="container-placeholder">
                    <i class="fas fa-box"></i>
                    <p>{{{localize "ionrift-quartermaster.cacheGenerator.noContainerMatched"}}}</p>
                </div>
                {{/if}}

            {{else}}
            {{!-- No result yet --}}
            <div class="container-placeholder">
                <i class="fas fa-treasure-chest"></i>
                <p>{{{localize "ionrift-quartermaster.cacheGenerator.generateCacheToSeeContainer"}}}</p>
            </div>
            {{/if}}
        </div>{{!-- /.cache-right --}}

    </div>{{!-- /.cache-split-layout --}}
</form>

