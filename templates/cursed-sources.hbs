<form class="ionrift-loot-pool-config ionrift-cursed-sources">
    <p class="pool-instructions">
        {{localize "ionrift-quartermaster.forge.cursedSourcesInstructions"}}
    </p>

    <div class="scroll-forge-toolbar">
        <button type="button" class="cache-btn-accent cursed-sources-toggle-selection" title="{{localize 'ionrift-quartermaster.forge.toggleAllCompendiumsTitle'}}">
            <i class="fas fa-right-left"></i> {{localize "ionrift-quartermaster.forge.toggleAll"}}
        </button>
    </div>

    <div class="cursed-sources-scroll">
        {{#each groups}}
        <div class="pool-group">
            <div class="pool-group-header">
                <i class="fas fa-box-archive"></i> {{this.label}}
            </div>
            {{#each this.packs}}
            <label class="pool-pack-row">
                <input type="checkbox" name="cpack-{{this.id}}" {{#if this.enabled}}checked{{/if}} />
                <span class="pool-pack-label">{{this.label}}</span>
                <span class="pool-pack-id">{{this.id}}{{#if this.count}} ({{this.count}} {{localize "ionrift-quartermaster.forge.items"}}){{/if}}</span>
            </label>
            {{/each}}
        </div>
        {{/each}}
    </div>

    <footer class="pool-footer">
        <button type="submit" class="cache-btn-accent">
            <i class="fas fa-save"></i> {{localize "ionrift-quartermaster.forge.saveSourcesLower"}}
        </button>
    </footer>
</form>
