{{!-- Phase 3: Done / compiled result --}}
<div class="forge-pane-done">
    <div class="forge-done-check">
        <i class="fas fa-circle-check"></i>
    </div>

    {{#if isScrollForge}}
    <h3 class="forge-done-title">{{localize "ionrift-quartermaster.forge.doneScrollsTitle"}}</h3>
    <p class="forge-done-subtitle">{{localize "ionrift-quartermaster.forge.doneScrollsSubtitle"}}</p>
    {{else if isCursedItems}}
    <h3 class="forge-done-title">{{localize "ionrift-quartermaster.forge.doneCursedTitle"}}</h3>
    <p class="forge-done-subtitle">{{localize "ionrift-quartermaster.forge.doneCursedSubtitle"}}</p>
    {{else}}
    <h3 class="forge-done-title">{{localize "ionrift-quartermaster.forge.doneLootTitle"}}</h3>
    <p class="forge-done-subtitle">{{localize "ionrift-quartermaster.forge.doneLootSubtitle"}}</p>
    {{/if}}

    <div class="forge-stat-cards">
        <div class="forge-stat-card">
            {{#if isScrollForge}}
            <i class="fas fa-scroll"></i>
            {{else if isCursedItems}}
            <i class="fas fa-skull"></i>
            {{else}}
            <i class="fas fa-treasure-chest"></i>
            {{/if}}
            <span class="forge-stat-value">{{doneResult.primary.value}}</span>
            <span class="forge-stat-label">{{doneResult.primary.label}}</span>
        </div>
        <div class="forge-stat-card">
            {{#if isScrollForge}}
            <i class="fas fa-book-sparkles"></i>
            {{else if isCursedItems}}
            <i class="fas fa-database"></i>
            {{else}}
            <i class="fas fa-wand-magic-sparkles"></i>
            {{/if}}
            <span class="forge-stat-value">{{doneResult.secondary.value}}</span>
            <span class="forge-stat-label">{{doneResult.secondary.label}}</span>
        </div>
        {{#if doneResult.tertiary}}
        <div class="forge-stat-card">
            <i class="fas fa-database"></i>
            <span class="forge-stat-value">{{doneResult.tertiary.value}}</span>
            <span class="forge-stat-label">{{doneResult.tertiary.label}}</span>
        </div>
        {{/if}}
    </div>

    {{#if doneResult.showViewPack}}
    <button type="button" class="forge-view-compendium cache-btn-ghost" data-pack-id="{{doneResult.packId}}">
        <i class="fas fa-book-open"></i> {{localize "ionrift-quartermaster.forge.viewCompendium"}}
    </button>
    {{/if}}

    {{#if doneResult.skippedCount}}
    <div class="forge-skip-panel">
        <p class="forge-skip-panel-title"><i class="fas fa-triangle-exclamation"></i> {{localize "ionrift-quartermaster.forge.compatibilityWarnings"}}</p>
        <p class="forge-skip-panel-summary">{{doneResult.skippedSummary}}</p>
        <ul class="forge-skip-report">
            {{#each doneResult.skipReport.rows}}
            <li><span class="forge-skip-name">{{this.name}}</span>{{#if this.packId}} <span class="forge-skip-pack">{{this.packId}}</span>{{/if}} <span class="forge-skip-phase">[{{this.phase}}]</span></li>
            {{/each}}
            {{#if doneResult.skipReport.overflowCount}}
            <li class="forge-skip-overflow">{{localize "ionrift-quartermaster.forge.skipOverflow" count=doneResult.skipReport.overflowCount}}</li>
            {{/if}}
        </ul>
        <p class="forge-skip-hint">{{localize "ionrift-quartermaster.forge.skipHint"}}</p>
    </div>
    {{/if}}

    <p class="forge-done-note">
        {{#if isScrollForge}}{{localize "ionrift-quartermaster.forge.doneNoteScrolls"}}
        {{else if isCursedItems}}{{localize "ionrift-quartermaster.forge.doneNoteCursed"}}
        {{else}}{{localize "ionrift-quartermaster.forge.doneNoteLoot"}}{{/if}}
    </p>

    <footer class="forge-footer">
        <button type="button" class="forge-cancel-link forge-back">
            <i class="fas fa-arrow-left"></i> {{localize "ionrift-quartermaster.forge.backToSources"}}
        </button>
        <button type="button" class="cache-btn-accent forge-done">
            {{localize "ionrift-quartermaster.forge.done"}}
        </button>
    </footer>
</div>
