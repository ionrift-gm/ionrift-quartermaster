<form class="ionrift-loot-pool-config ionrift-cursed-import">
    <p class="pool-instructions">
        {{{localize "ionrift-quartermaster.forge.cursedImportInstructions"}}}
    </p>

    {{#if hasPacks}}
    <div class="cursed-import-toolbar">
        <label class="cursed-import-pack-label">
            <span>{{localize "ionrift-quartermaster.forge.compendium"}}</span>
            <select name="cursedImportPack" class="cursed-import-pack-select">
                {{#each packs}}
                <option value="{{this.id}}" {{#if (eq this.id ../selectedPackId)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </label>
        <div class="cursed-import-toolbar-actions">
            <button type="button" class="cache-btn-accent cursed-import-toggle-selection" title="{{localize 'ionrift-quartermaster.forge.toggleAllSelectionTitle'}}">
                <i class="fas fa-right-left"></i> {{localize "ionrift-quartermaster.forge.toggleAll"}}
            </button>
        </div>
    </div>

    <div class="loot-pool-sources-scroll cursed-import-scroll">
        {{#each items}}
        <label class="pool-pack-row cursed-import-row{{#if this.inPool}} in-pool{{/if}}" data-uuid="{{this.uuid}}">
            <input type="checkbox" {{#if this.inPool}}checked{{/if}} />
            <span class="pool-pack-label">{{this.name}}</span>
            <span class="cursed-import-badges">
                <span class="cursed-import-tier-badge" title="{{localize 'ionrift-quartermaster.forge.curseTierTitle'}}">T{{this.tier}}</span>
                <span class="cursed-import-type-badge" title="{{localize 'ionrift-quartermaster.forge.curseTypeTitle'}}">{{this.curseType}}</span>
            </span>
        </label>
        {{else}}
        <p class="cursed-import-empty">{{{localize "ionrift-quartermaster.forge.cursedImportEmpty"}}}</p>
        {{/each}}
    </div>

    <footer class="pool-footer">
        <button type="button" class="cache-btn-accent action-cursed-import-apply">
            <i class="fas fa-check"></i> {{localize "ionrift-quartermaster.forge.apply"}}
        </button>
    </footer>
    <p class="scroll-jitter-note cursed-import-footer-note">
        <button type="button" class="cursed-import-manage-sources">{{localize "ionrift-quartermaster.forge.manageSources"}}</button> {{localize "ionrift-quartermaster.forge.manageSourcesAddRemoveNote"}}
    </p>
    {{else}}
    <p class="cursed-import-empty">
        {{localize "ionrift-quartermaster.forge.noCompendiumsRegistered"}} <button type="button" class="cursed-import-manage-sources">{{localize "ionrift-quartermaster.forge.manageSources"}}</button> {{{localize "ionrift-quartermaster.forge.manageSourcesRebuildNote"}}}
    </p>
    {{/if}}
</form>
