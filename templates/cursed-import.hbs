<form class="ionrift-loot-pool-config ionrift-cursed-import">
    <p class="pool-instructions">
        {{localize 'IONRIFT.QUARTERMASTER.CURSED.ImportInstructions'}}
    </p>

    {{#if hasPacks}}
    <div class="cursed-import-toolbar">
        <label class="cursed-import-pack-label">
            <span>{{localize 'IONRIFT.QUARTERMASTER.CURSED.Compendium'}}</span>
            <select name="cursedImportPack" class="cursed-import-pack-select">
                {{#each packs}}
                <option value="{{this.id}}" {{#if (eq this.id ../selectedPackId)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </label>
        <div class="cursed-import-toolbar-actions">
            <button type="button" class="cache-btn-accent cursed-import-toggle-selection" title="{{localize 'IONRIFT.QUARTERMASTER.CONFIG.ToggleRowsTitle'}}">
                <i class="fas fa-right-left"></i> {{localize 'IONRIFT.QUARTERMASTER.CONFIG.ToggleAll'}}
            </button>
        </div>
    </div>

    <div class="loot-pool-sources-scroll cursed-import-scroll">
        {{#each items}}
        <label class="pool-pack-row cursed-import-row{{#if this.inPool}} in-pool{{/if}}" data-uuid="{{this.uuid}}">
            <input type="checkbox" {{#if this.inPool}}checked{{/if}} />
            <span class="pool-pack-label">{{this.name}}</span>
            <span class="cursed-import-badges">
                <span class="cursed-import-tier-badge" title="{{localize 'IONRIFT.QUARTERMASTER.CURSED.CurseTier'}}">T{{this.tier}}</span>
                <span class="cursed-import-type-badge" title="{{localize 'IONRIFT.QUARTERMASTER.CURSED.CurseType'}}">{{this.curseType}}</span>
            </span>
        </label>
        {{else}}
        <p class="cursed-import-empty">{{localize 'IONRIFT.QUARTERMASTER.CURSED.NoMetaItems'}}</p>
        {{/each}}
    </div>

    <footer class="pool-footer">
        <button type="button" class="cache-btn-accent action-cursed-import-apply">
            <i class="fas fa-check"></i> {{localize 'IONRIFT.QUARTERMASTER.CURSED.Apply'}}
        </button>
    </footer>
    <p class="scroll-jitter-note cursed-import-footer-note">
        <button type="button" class="cursed-import-manage-sources">{{localize 'IONRIFT.QUARTERMASTER.CURSED.ManageSources'}}</button>{{localize 'IONRIFT.QUARTERMASTER.CURSED.ManageSourcesHint'}}
    </p>
    {{else}}
    <p class="cursed-import-empty">
        {{localize 'IONRIFT.QUARTERMASTER.CURSED.NoPacksYet'}} <button type="button" class="cursed-import-manage-sources">{{localize 'IONRIFT.QUARTERMASTER.CURSED.ManageSources'}}</button>{{localize 'IONRIFT.QUARTERMASTER.CURSED.NoPacksHint'}}
    </p>
    {{/if}}
</form>
