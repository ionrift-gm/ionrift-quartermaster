<form class="ionrift-loot-pool-config ionrift-curse-forge-sources">
    {{#if alreadyCompiled}}
    <p class="pool-instructions">
        {{{localize "ionrift-quartermaster.forge.curseRecompileExisting"}}}
        {{localize "ionrift-quartermaster.forge.curseRecompileRebuild"}}
        {{localize "ionrift-quartermaster.forge.curseRecompileRecipeCount" count=recipeCount}}
    </p>
    {{else}}
    <div class="scroll-forge-welcome">
        <div class="scroll-forge-welcome-icon">
            <i class="fas fa-skull"></i>
        </div>
        <h3>{{{localize "ionrift-quartermaster.forge.compileDndCurses"}}}</h3>
        <p class="scroll-forge-welcome-desc">
            {{{localize "ionrift-quartermaster.forge.curseForgeWelcomeDesc" count=recipeCount}}}
        </p>
        <p class="scroll-forge-welcome-action">
            {{{localize "ionrift-quartermaster.forge.curseForgeWelcomeAction"}}}
        </p>
        <p class="scroll-forge-welcome-note">
            {{localize "ionrift-quartermaster.forge.curseForgeWelcomeNote"}}
        </p>
    </div>
    {{/if}}

    <div class="scroll-forge-toolbar">
        <button type="button" class="cache-btn-accent curse-forge-select-all">
            <i class="fas fa-check-double"></i> {{localize "ionrift-quartermaster.forge.selectAll"}}
        </button>
        <button type="button" class="cache-btn-accent curse-forge-select-none">
            <i class="fas fa-times"></i> {{localize "ionrift-quartermaster.forge.selectNone"}}
        </button>
    </div>

    {{#each groups}}
    <div class="pool-group">
        <div class="pool-group-header">
            <i class="fas fa-box-archive"></i> {{this.label}}
        </div>
        {{#each this.packs}}
        <label class="pool-pack-row">
            <input type="checkbox" name="pack-{{this.id}}" {{#if this.enabled}}checked{{/if}} />
            <span class="pool-pack-label">{{this.label}}</span>
            <span class="pool-pack-id">{{this.id}} ({{this.count}} {{localize "ionrift-quartermaster.forge.items"}})</span>
        </label>
        {{/each}}
    </div>
    {{/each}}

    <footer class="pool-footer">
        <button type="submit" class="cache-btn-accent">
            <i class="fas fa-hammer"></i> {{localize "ionrift-quartermaster.forge.compile"}}
        </button>
    </footer>
</form>
