<form class="ionrift-loot-pool-config ionrift-scroll-forge-sources">
    {{#if firstRun}}
    <div class="scroll-forge-welcome">
        <div class="scroll-forge-welcome-icon">
            <i class="fas fa-scroll"></i>
        </div>
        <h3>{{localize 'IONRIFT.QUARTERMASTER.CONFIG.ScrollForgeWelcomeTitle'}}</h3>
        <p class="scroll-forge-welcome-desc">
            {{localize 'IONRIFT.QUARTERMASTER.CONFIG.ScrollForgeWelcomeDesc'}}
        </p>
        <p class="scroll-forge-welcome-action">
            {{localize 'IONRIFT.QUARTERMASTER.CONFIG.ScrollForgeWelcomeAction'}}
        </p>
        <p class="scroll-forge-welcome-note">
            {{localize 'IONRIFT.QUARTERMASTER.CONFIG.ScrollForgeWelcomeNote'}}
        </p>
    </div>
    {{else}}
    <p class="pool-instructions">
        {{localize 'IONRIFT.QUARTERMASTER.CONFIG.ScrollForgeInstructions'}}
    </p>
    {{/if}}

    <div class="scroll-forge-toolbar">
        <button type="button" class="cache-btn-accent scroll-forge-select-all">
            <i class="fas fa-check-double"></i> {{localize 'IONRIFT.QUARTERMASTER.CONFIG.SelectAll'}}
        </button>
        <button type="button" class="cache-btn-accent scroll-forge-select-none">
            <i class="fas fa-times"></i> {{localize 'IONRIFT.QUARTERMASTER.CONFIG.SelectNone'}}
        </button>
    </div>

    {{#each groups}}
    <div class="pool-group">
        <div class="pool-group-header">
            <i class="fas fa-box-archive"></i> {{this.label}}
        </div>
        {{#each this.packs}}
        <label class="pool-pack-row">
            <input type="checkbox" name="pack-{{this.id}}" {{#if this.enabled}}checked{{/if}} />
            <span class="pool-pack-label">{{this.label}}</span>
            <span class="pool-pack-id">{{this.id}} {{localize 'IONRIFT.QUARTERMASTER.CONFIG.SpellsCount' count=this.count}}</span>
        </label>
        {{/each}}
    </div>
    {{/each}}

    <footer class="pool-footer">
        <button type="submit" class="cache-btn-accent">
            <i class="fas fa-save"></i> {{localize 'IONRIFT.QUARTERMASTER.CONFIG.SaveAndCompile'}}
        </button>
    </footer>
</form>
