<form class="ionrift-loot-pool-config ionrift-scroll-forge-sources">
    {{#if firstRun}}
    <div class="scroll-forge-welcome">
        <div class="scroll-forge-welcome-icon">
            <i class="fas fa-scroll"></i>
        </div>
        <h3>{{localize "ionrift-quartermaster.forge.welcomeScrollForgeTitle"}}</h3>
        <p class="scroll-forge-welcome-desc">
            {{{localize "ionrift-quartermaster.forge.welcomeScrollForgeDesc"}}}
        </p>
        <p class="scroll-forge-welcome-action">
            {{{localize "ionrift-quartermaster.forge.welcomeScrollForgeAction"}}}
        </p>
        <p class="scroll-forge-welcome-note">
            {{localize "ionrift-quartermaster.forge.welcomeScrollForgeNote"}}
        </p>
    </div>
    {{else}}
    <p class="pool-instructions">
        {{localize "ionrift-quartermaster.forge.scrollForgeInstructions1"}}
        {{{localize "ionrift-quartermaster.forge.scrollForgeInstructions2"}}}
        {{localize "ionrift-quartermaster.forge.scrollForgeInstructions3"}}
    </p>
    {{/if}}

    <div class="scroll-forge-toolbar">
        <button type="button" class="cache-btn-accent scroll-forge-select-all">
            <i class="fas fa-check-double"></i> {{localize "ionrift-quartermaster.forge.selectAll"}}
        </button>
        <button type="button" class="cache-btn-accent scroll-forge-select-none">
            <i class="fas fa-times"></i> {{localize "ionrift-quartermaster.forge.selectNone"}}
        </button>
    </div>

    {{#each groups}}
    <div class="pool-group">
        <div class="pool-group-header">
            <i class="fas fa-box-archive"></i> {{this.label}}
        </div>
        {{#each this.packs}}
        <label class="pool-pack-row">
            <input type="checkbox" name="pack-{{this.id}}" {{#if this.enabled}}checked{{/if}} />
            <span class="pool-pack-label">{{this.label}}</span>
            <span class="pool-pack-id">{{this.id}} ({{this.count}} {{localize "ionrift-quartermaster.forge.spellsCount"}})</span>
        </label>
        {{/each}}
    </div>
    {{/each}}

    <footer class="pool-footer">
        <button type="submit" class="cache-btn-accent">
            <i class="fas fa-save"></i> {{localize "ionrift-quartermaster.forge.saveAndCompile"}}
        </button>
    </footer>
</form>
